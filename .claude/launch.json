{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nerve-drag-lab",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "-q", "--release", "-p", "nerve", "--bin", "nerve", "--", "serve", "--specs", "specs", "--addr", "127.0.0.1:8787", "--models", "models/served"],
      "port": 8787
    },
    {
      "name": "nerve-site",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8791", "--directory", "site/dist"],
      "port": 8791
    },
    {
      "name": "nerve-site-worker",
      "runtimeExecutable": "wrangler",
      "runtimeArgs": ["dev", "--config", "site/wrangler.toml", "--port", "8792"],
      "port": 8792
    }
  ]
}
