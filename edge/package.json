{
  "name": "nerve-edge",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "upload": "node scripts/upload.mjs",
    "bundle": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js",
    "local": "scripts/local.sh",
    "smoke": "node scripts/smoke.mjs http://127.0.0.1:8788 counter",
    "parity": "esbuild scripts/parity.mts --bundle --platform=node --format=esm --outfile=dist/parity.mjs --log-level=warning && node dist/parity.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "workerd": "^1.20261104.1",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "fzstd": "^0.1.1"
  }
}
