# Dragology's `fifteen` (src/demos/fifteen.tsx), the sliding-tile puzzle: drag a piece and it trades
# places with an orthogonal neighbour when one of the two is the blank, and the blank is draggable too.
# Scaled down from 4 x 4 to 3 x 2: tiles 1-5 and the blank, cells numbered row by row from 0.
# Tile 5 has no field (it is on the cell no other piece is on), so the 7,776 tuples hold 720
# boards; 360 are reachable from any one of them, as in the real puzzle. Dragology chains snaps so
# one gesture can make several slides; here a gesture makes one slide.
# `hint` is the next slide of a shortest solution (1 2 3 / 4 5 _ is solved), given only by example: one per
# reachable board, from a breadth-first search in the generator (the farthest board is 21 slides out).
# The spec only bounds it, to a legal slide. `solved` fires on the step that completes the board, so a
# machine can pulse `hint` every tick and the puzzle solves itself.
# Generated by `nerve gen fifteen` (crates/nerve/src/gen/fifteen.rs); edit the generator, not this file.
nerve: 1
name: fifteen
state:
  t1: {type: int, range: [0, 5]}   # cell of tile 1
  t2: {type: int, range: [0, 5]}   # cell of tile 2
  t3: {type: int, range: [0, 5]}   # cell of tile 3
  t4: {type: int, range: [0, 5]}   # cell of tile 4
  blank: {type: int, range: [0, 5]}   # cell of the blank
actions:
  slide_1: {}   # tile 1 slides into the blank, if it is next to it
  slide_2: {}   # tile 2 slides into the blank, if it is next to it
  slide_3: {}   # tile 3 slides into the blank, if it is next to it
  slide_4: {}   # tile 4 slides into the blank, if it is next to it
  slide_5: {}   # tile 5 slides into the blank, if it is next to it
  slide_blank: {params: {to: {type: int, range: [0, 5]}}}   # the blank trades places with the tile at `to`
  hint: {}   # the next slide of a shortest solution: shown by examples, never written down
transitions:
  slide_1:
    when: "abs(t1 // 3 - blank // 3) + abs(t1 % 3 - blank % 3) == 1"
    t1: "blank"
    blank: "t1"
    emits: { solved: "t1 == 0 and t2 == 1 and t3 == 2 and t4 == 3 and blank == 5 and not (old.t1 == 0 and old.t2 == 1 and old.t3 == 2 and old.t4 == 3 and old.blank == 5)" }
  slide_2:
    when: "abs(t2 // 3 - blank // 3) + abs(t2 % 3 - blank % 3) == 1"
    t2: "blank"
    blank: "t2"
    emits: { solved: "t1 == 0 and t2 == 1 and t3 == 2 and t4 == 3 and blank == 5 and not (old.t1 == 0 and old.t2 == 1 and old.t3 == 2 and old.t4 == 3 and old.blank == 5)" }
  slide_3:
    when: "abs(t3 // 3 - blank // 3) + abs(t3 % 3 - blank % 3) == 1"
    t3: "blank"
    blank: "t3"
    emits: { solved: "t1 == 0 and t2 == 1 and t3 == 2 and t4 == 3 and blank == 5 and not (old.t1 == 0 and old.t2 == 1 and old.t3 == 2 and old.t4 == 3 and old.blank == 5)" }
  slide_4:
    when: "abs(t4 // 3 - blank // 3) + abs(t4 % 3 - blank % 3) == 1"
    t4: "blank"
    blank: "t4"
    emits: { solved: "t1 == 0 and t2 == 1 and t3 == 2 and t4 == 3 and blank == 5 and not (old.t1 == 0 and old.t2 == 1 and old.t3 == 2 and old.t4 == 3 and old.blank == 5)" }
  slide_5:
    when: "abs((15 - t1 - t2 - t3 - t4 - blank) // 3 - blank // 3) + abs((15 - t1 - t2 - t3 - t4 - blank) % 3 - blank % 3) == 1"
    blank: "(15 - t1 - t2 - t3 - t4 - blank)"
    emits: { solved: "t1 == 0 and t2 == 1 and t3 == 2 and t4 == 3 and blank == 5 and not (old.t1 == 0 and old.t2 == 1 and old.t3 == 2 and old.t4 == 3 and old.blank == 5)" }
  slide_blank:
    when: "abs(blank // 3 - to // 3) + abs(blank % 3 - to % 3) == 1"
    blank: "to"
    t1: "blank if t1 == to else t1"
    t2: "blank if t2 == to else t2"
    t3: "blank if t3 == to else t3"
    t4: "blank if t4 == to else t4"
    emits: { solved: "t1 == 0 and t2 == 1 and t3 == 2 and t4 == 3 and blank == 5 and not (old.t1 == 0 and old.t2 == 1 and old.t3 == 2 and old.t4 == 3 and old.blank == 5)" }
  # the spec's own hint changes nothing: the network's is learned from the examples under `learn`
  hint:
    t1: "t1"
    t2: "t2"
    t3: "t3"
    t4: "t4"
    blank: "blank"
    emits: { solved: "t1 == 0 and t2 == 1 and t3 == 2 and t4 == 3 and blank == 5 and not (old.t1 == 0 and old.t2 == 1 and old.t3 == 2 and old.t4 == 3 and old.blank == 5)" }
invariants:
  - "t1 != t2 and t1 != t3 and t1 != t4 and t1 != blank and t2 != t3 and t2 != t4 and t2 != blank and t3 != t4 and t3 != blank and t4 != blank"   # no two pieces share a cell (tile 5 gets the one left over)
ensures:
  - { holds: "abs(blank // 3 - old.blank // 3) + abs(blank % 3 - old.blank % 3) <= 1" }   # one slide at a time: the blank moves to a neighbouring cell or stays
  - { holds: "int(t1 != old.t1) + int(t2 != old.t2) + int(t3 != old.t3) + int(t4 != old.t4) + int((15 - t1 - t2 - t3 - t4 - blank) != (15 - old.t1 - old.t2 - old.t3 - old.t4 - old.blank)) <= 1" }   # and at most one tile moves, onto the blank's old cell
  - { after: slide_1, holds: "(t1 == old.blank and blank == old.t1) or (t1 == old.t1 and blank == old.blank)" }   # the tile trades places with the blank, or nothing moves
  - { after: slide_2, holds: "(t2 == old.blank and blank == old.t2) or (t2 == old.t2 and blank == old.blank)" }   # the tile trades places with the blank, or nothing moves
  - { after: slide_3, holds: "(t3 == old.blank and blank == old.t3) or (t3 == old.t3 and blank == old.blank)" }   # the tile trades places with the blank, or nothing moves
  - { after: slide_4, holds: "(t4 == old.blank and blank == old.t4) or (t4 == old.t4 and blank == old.blank)" }   # the tile trades places with the blank, or nothing moves
  - { after: slide_5, holds: "((15 - t1 - t2 - t3 - t4 - blank) == old.blank and blank == (15 - old.t1 - old.t2 - old.t3 - old.t4 - old.blank)) or ((15 - t1 - t2 - t3 - t4 - blank) == (15 - old.t1 - old.t2 - old.t3 - old.t4 - old.blank) and blank == old.blank)" }   # the tile trades places with the blank, or nothing moves
  - { after: slide_blank, holds: "blank == to or blank == old.blank" }   # the blank lands where it was dropped, or stays
  - { after: hint, holds: "int(t1 != old.t1) + int(t2 != old.t2) + int(t3 != old.t3) + int(t4 != old.t4) + int((15 - t1 - t2 - t3 - t4 - blank) != (15 - old.t1 - old.t2 - old.t3 - old.t4 - old.blank)) <= 1 and ((t1 == old.t1 and t2 == old.t2 and t3 == old.t3 and t4 == old.t4 and blank == old.blank) or (abs(blank // 3 - old.blank // 3) + abs(blank % 3 - old.blank % 3) == 1 and ((t1 == old.blank and blank == old.t1) or (t2 == old.blank and blank == old.t2) or (t3 == old.blank and blank == old.t3) or (t4 == old.blank and blank == old.t4) or ((15 - t1 - t2 - t3 - t4 - blank) == old.blank and blank == (15 - old.t1 - old.t2 - old.t3 - old.t4 - old.blank)))))" }   # a hint may only make a legal slide: the blank stays, or trades places with a neighbouring tile
scene:
  box: [14, 14, 206, 146]
  shapes:
    - {rect: [110, 80, 180, 120], r: 6, color: panel, stroke: line, width: 1.5}
    - {line: [80, 20, 80, 140], color: line, width: 1.5}
    - {line: [140, 20, 140, 140], color: line, width: 1.5}
    - {line: [20, 80, 200, 80], color: line, width: 1.5}
render:
  tile1: { x: "50 + 60 * (t1 % 3)", y: "50 + 60 * (t1 // 3)", shapes: [{rect: [0, 0, 52, 52], r: 6, color: f1, stroke: ink, width: 1.5}, {label: '1', at: [0, 0], color: white, size: 3}] }
  tile2: { x: "50 + 60 * (t2 % 3)", y: "50 + 60 * (t2 // 3)", shapes: [{rect: [0, 0, 52, 52], r: 6, color: f2, stroke: ink, width: 1.5}, {label: '2', at: [0, 0], color: white, size: 3}] }
  tile3: { x: "50 + 60 * (t3 % 3)", y: "50 + 60 * (t3 // 3)", shapes: [{rect: [0, 0, 52, 52], r: 6, color: f3, stroke: ink, width: 1.5}, {label: '3', at: [0, 0], color: white, size: 3}] }
  tile4: { x: "50 + 60 * (t4 % 3)", y: "50 + 60 * (t4 // 3)", shapes: [{rect: [0, 0, 52, 52], r: 6, color: f4, stroke: ink, width: 1.5}, {label: '4', at: [0, 0], color: white, size: 3}] }
  tile5: { x: "50 + 60 * ((15 - t1 - t2 - t3 - t4 - blank) % 3)", y: "50 + 60 * ((15 - t1 - t2 - t3 - t4 - blank) // 3)", shapes: [{rect: [0, 0, 52, 52], r: 6, color: f5, stroke: ink, width: 1.5}, {label: '5', at: [0, 0], color: white, size: 3}] }
  blank: { x: "50 + 60 * (blank % 3)", y: "50 + 60 * (blank // 3)", shape: {rect: [0, 0, 52, 52], r: 6, color: bg, stroke: mut, width: 1.5} }
futures:
  # one gesture per piece, each moving only that piece: a tile goes to the blank if it is next to it
  drag_1: { kind: closest, over: t1, grab: tile1, action: slide_1, stickiness: 6, floating: true }
  drag_2: { kind: closest, over: t2, grab: tile2, action: slide_2, stickiness: 6, floating: true }
  drag_3: { kind: closest, over: t3, grab: tile3, action: slide_3, stickiness: 6, floating: true }
  drag_4: { kind: closest, over: t4, grab: tile4, action: slide_4, stickiness: 6, floating: true }
  drag_5: { kind: closest, over: blank, grab: tile5, action: slide_5, stickiness: 6, floating: true }   # tile 5 has no field; sliding it always moves the blank
  # Dragology's "weird experiment": the blank is draggable too, onto any tile next to it
  drag_blank: { kind: closest, over: blank, grab: blank, action: slide_blank, stickiness: 6, floating: true }
learn:
  # the `hint` transition above is the fallback; the examples are the whole breadth-first solution
  - name: solve
    action: hint
    examples:
      - { state: {t1: 0, t2: 1, t3: 2, t4: 3, blank: 4}, next: {t1: 0, t2: 1, t3: 2, t4: 3, blank: 5} }
      - { state: {t1: 0, t2: 1, t3: 2, t4: 3, blank: 5}, next: {t1: 0, t2: 1, t3: 2, t4: 3, blank: 5} }
      - { state: {t1: 0, t2: 1, t3: 2, t4: 4, blank: 3}, next: {t1: 0, t2: 1, t3: 2, t4: 3, blank: 4} }
      - { state: {t1: 0, t2: 1, t3: 3, t4: 4, blank: 2}, next: {t1: 0, t2: 1, t3: 3, t4: 4, blank: 5} }
      - { state: {t1: 0, t2: 1, t3: 3, t4: 4, blank: 5}, next: {t1: 0, t2: 1, t3: 3, t4: 5, blank: 4} }
      - { state: {t1: 0, t2: 1, t3: 3, t4: 5, blank: 4}, next: {t1: 0, t2: 1, t3: 4, t4: 5, blank: 3} }
      - { state: {t1: 0, t2: 1, t3: 4, t4: 2, blank: 5}, next: {t1: 0, t2: 1, t3: 5, t4: 2, blank: 4} }
      - { state: {t1: 0, t2: 1, t3: 4, t4: 5, blank: 2}, next: {t1: 0, t2: 1, t3: 4, t4: 2, blank: 5} }
      - { state: {t1: 0, t2: 1, t3: 4, t4: 5, blank: 3}, next: {t1: 3, t2: 1, t3: 4, t4: 5, blank: 0} }
      - { state: {t1: 0, t2: 1, t3: 5, t4: 2, blank: 3}, next: {t1: 3, t2: 1, t3: 5, t4: 2, blank: 0} }
      - { state: {t1: 0, t2: 1, t3: 5, t4: 2, blank: 4}, next: {t1: 0, t2: 1, t3: 5, t4: 2, blank: 3} }
      - { state: {t1: 0, t2: 1, t3: 5, t4: 3, blank: 2}, next: {t1: 0, t2: 1, t3: 2, t4: 3, blank: 5} }
      - { state: {t1: 0, t2: 2, t3: 1, t4: 4, blank: 5}, next: {t1: 0, t2: 2, t3: 1, t4: 5, blank: 4} }
      - { state: {t1: 0, t2: 2, t3: 1, t4: 5, blank: 3}, next: {t1: 3, t2: 2, t3: 1, t4: 5, blank: 0} }
      - { state: {t1: 0, t2: 2, t3: 1, t4: 5, blank: 4}, next: {t1: 0, t2: 2, t3: 4, t4: 5, blank: 1} }
      - { state: {t1: 0, t2: 2, t3: 3, t4: 1, blank: 4}, next: {t1: 0, t2: 2, t3: 3, t4: 4, blank: 1} }
      - { state: {t1: 0, t2: 2, t3: 3, t4: 1, blank: 5}, next: {t1: 0, t2: 5, t3: 3, t4: 1, blank: 2} }
      - { state: {t1: 0, t2: 2, t3: 3, t4: 4, blank: 1}, next: {t1: 0, t2: 1, t3: 3, t4: 4, blank: 2} }
      - { state: {t1: 0, t2: 2, t3: 4, t4: 1, blank: 3}, next: {t1: 0, t2: 2, t3: 3, t4: 1, blank: 4} }
      - { state: {t1: 0, t2: 2, t3: 4, t4: 3, blank: 5}, next: {t1: 0, t2: 2, t3: 5, t4: 3, blank: 4} }
      - { state: {t1: 0, t2: 2, t3: 4, t4: 5, blank: 1}, next: {t1: 0, t2: 1, t3: 4, t4: 5, blank: 2} }
      - { state: {t1: 0, t2: 2, t3: 5, t4: 3, blank: 1}, next: {t1: 0, t2: 1, t3: 5, t4: 3, blank: 2} }
      - { state: {t1: 0, t2: 2, t3: 5, t4: 3, blank: 4}, next: {t1: 0, t2: 2, t3: 5, t4: 3, blank: 1} }
      - { state: {t1: 0, t2: 2, t3: 5, t4: 4, blank: 3}, next: {t1: 0, t2: 2, t3: 5, t4: 3, blank: 4} }
