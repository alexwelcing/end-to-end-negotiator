# Dragology's Tower of Hanoi, four disks (d1 smallest). The rules are written down: only a top
# disk moves, and never onto a smaller one, so a drag can only offer legal drops. `hint` is not:
# it is the optimal next move toward peg 2, given only by example (one per position). Training
# holds some examples out, and the network is scored on positions whose solution it never saw.
# Generated by scripts/gen_hanoi_spec.py; edit the script, not this file.
nerve: 1
name: hanoi
state:
  d1: {type: int, range: [0, 2]}   # peg of disk 1
  d2: {type: int, range: [0, 2]}   # peg of disk 2
  d3: {type: int, range: [0, 2]}   # peg of disk 3
  d4: {type: int, range: [0, 2]}   # peg of disk 4
actions:
  move: {params: {src: {type: int, range: [0, 2]}, dst: {type: int, range: [0, 2]}}}
  hint: {}   # the optimal next move toward peg 2: shown by examples, never written down
transitions:
  move:
    when: "(1 if d1 == src else 2 if d2 == src else 3 if d3 == src else 4 if d4 == src else 5) < 5 and (1 if d1 == src else 2 if d2 == src else 3 if d3 == src else 4 if d4 == src else 5) < (1 if d1 == dst else 2 if d2 == dst else 3 if d3 == dst else 4 if d4 == dst else 5)"
    d1: "dst if (1 if d1 == src else 2 if d2 == src else 3 if d3 == src else 4 if d4 == src else 5) == 1 else d1"
    d2: "dst if (1 if d1 == src else 2 if d2 == src else 3 if d3 == src else 4 if d4 == src else 5) == 2 else d2"
    d3: "dst if (1 if d1 == src else 2 if d2 == src else 3 if d3 == src else 4 if d4 == src else 5) == 3 else d3"
    d4: "dst if (1 if d1 == src else 2 if d2 == src else 3 if d3 == src else 4 if d4 == src else 5) == 4 else d4"
ensures:
  - { after: move, holds: "(int(d1 != old.d1) + int(d2 != old.d2) + int(d3 != old.d3) + int(d4 != old.d4)) <= 1 and (d1 == old.d1 or (True)) and (d2 == old.d2 or (old.d1 != old.d2 and old.d1 != d2)) and (d3 == old.d3 or (old.d1 != old.d3 and old.d1 != d3 and old.d2 != old.d3 and old.d2 != d3)) and (d4 == old.d4 or (old.d1 != old.d4 and old.d1 != d4 and old.d2 != old.d4 and old.d2 != d4 and old.d3 != old.d4 and old.d3 != d4))" }
  - { after: hint, holds: "(int(d1 != old.d1) + int(d2 != old.d2) + int(d3 != old.d3) + int(d4 != old.d4)) <= 1 and (d1 == old.d1 or (True)) and (d2 == old.d2 or (old.d1 != old.d2 and old.d1 != d2)) and (d3 == old.d3 or (old.d1 != old.d3 and old.d1 != d3 and old.d2 != old.d3 and old.d2 != d3)) and (d4 == old.d4 or (old.d1 != old.d4 and old.d1 != d4 and old.d2 != old.d4 and old.d2 != d4 and old.d3 != old.d4 and old.d3 != d4))" }   # a hint may only make a legal move
render:
  disk1: { x: "70 + 140 * d1", y: "200 - 30 * (int(d2 == d1) + int(d3 == d1) + int(d4 == d1))" }
  disk2: { x: "70 + 140 * d2", y: "200 - 30 * (int(d3 == d2) + int(d4 == d2))" }
  disk3: { x: "70 + 140 * d3", y: "200 - 30 * (int(d4 == d3))" }
  disk4: { x: "70 + 140 * d4", y: "200 - 30 * (0)" }
futures:
  # one gesture per disk: only a top disk has anywhere to go, and only onto a larger disk
  drag_disk1: { kind: closest, over: d1, grab: disk1, action: move, stickiness: 8, floating: true }
  drag_disk2: { kind: closest, over: d2, grab: disk2, action: move, stickiness: 8, floating: true }
  drag_disk3: { kind: closest, over: d3, grab: disk3, action: move, stickiness: 8, floating: true }
  drag_disk4: { kind: closest, over: d4, grab: disk4, action: move, stickiness: 8, floating: true }
learn:
  - name: solve
    action: hint
    fallback: { d1: "d1" }
    examples:
      - { state: {d1: 0, d2: 0, d3: 0, d4: 0}, next: {d1: 1, d2: 0, d3: 0, d4: 0} }
      - { state: {d1: 0, d2: 0, d3: 0, d4: 1}, next: {d1: 0, d2: 0, d3: 0, d4: 2} }
      - { state: {d1: 0, d2: 0, d3: 0, d4: 2}, next: {d1: 2, d2: 0, d3: 0, d4: 2} }
      - { state: {d1: 0, d2: 0, d3: 1, d4: 0}, next: {d1: 2, d2: 0, d3: 1, d4: 0} }
      - { state: {d1: 0, d2: 0, d3: 1, d4: 1}, next: {d1: 1, d2: 0, d3: 1, d4: 1} }
      - { state: {d1: 0, d2: 0, d3: 1, d4: 2}, next: {d1: 0, d2: 0, d3: 2, d4: 2} }
      - { state: {d1: 0, d2: 0, d3: 2, d4: 0}, next: {d1: 0, d2: 0, d3: 1, d4: 0} }
      - { state: {d1: 0, d2: 0, d3: 2, d4: 1}, next: {d1: 2, d2: 0, d3: 2, d4: 1} }
      - { state: {d1: 0, d2: 0, d3: 2, d4: 2}, next: {d1: 1, d2: 0, d3: 2, d4: 2} }
      - { state: {d1: 0, d2: 1, d3: 0, d4: 0}, next: {d1: 0, d2: 2, d3: 0, d4: 0} }
      - { state: {d1: 0, d2: 1, d3: 0, d4: 1}, next: {d1: 2, d2: 1, d3: 0, d4: 1} }
      - { state: {d1: 0, d2: 1, d3: 0, d4: 2}, next: {d1: 1, d2: 1, d3: 0, d4: 2} }
      - { state: {d1: 0, d2: 1, d3: 1, d4: 0}, next: {d1: 1, d2: 1, d3: 1, d4: 0} }
      - { state: {d1: 0, d2: 1, d3: 1, d4: 1}, next: {d1: 0, d2: 2, d3: 1, d4: 1} }
      - { state: {d1: 0, d2: 1, d3: 1, d4: 2}, next: {d1: 2, d2: 1, d3: 1, d4: 2} }
      - { state: {d1: 0, d2: 1, d3: 2, d4: 0}, next: {d1: 2, d2: 1, d3: 2, d4: 0} }
      - { state: {d1: 0, d2: 1, d3: 2, d4: 1}, next: {d1: 1, d2: 1, d3: 2, d4: 1} }
      - { state: {d1: 0, d2: 1, d3: 2, d4: 2}, next: {d1: 0, d2: 2, d3: 2, d4: 2} }
      - { state: {d1: 0, d2: 2, d3: 0, d4: 0}, next: {d1: 2, d2: 2, d3: 0, d4: 0} }
      - { state: {d1: 0, d2: 2, d3: 0, d4: 1}, next: {d1: 1, d2: 2, d3: 0, d4: 1} }
      - { state: {d1: 0, d2: 2, d3: 0, d4: 2}, next: {d1: 0, d2: 1, d3: 0, d4: 2} }
      - { state: {d1: 0, d2: 2, d3: 1, d4: 0}, next: {d1: 0, d2: 1, d3: 1, d4: 0} }
      - { state: {d1: 0, d2: 2, d3: 1, d4: 1}, next: {d1: 2, d2: 2, d3: 1, d4: 1} }
      - { state: {d1: 0, d2: 2, d3: 1, d4: 2}, next: {d1: 1, d2: 2, d3: 1, d4: 2} }
      - { state: {d1: 0, d2: 2, d3: 2, d4: 0}, next: {d1: 1, d2: 2, d3: 2, d4: 0} }
      - { state: {d1: 0, d2: 2, d3: 2, d4: 1}, next: {d1: 0, d2: 1, d3: 2, d4: 1} }
      - { state: {d1: 0, d2: 2, d3: 2, d4: 2}, next: {d1: 2, d2: 2, d3: 2, d4: 2} }
      - { state: {d1: 1, d2: 0, d3: 0, d4: 0}, next: {d1: 1, d2: 2, d3: 0, d4: 0} }
      - { state: {d1: 1, d2: 0, d3: 0, d4: 1}, next: {d1: 0, d2: 0, d3: 0, d4: 1} }
      - { state: {d1: 1, d2: 0, d3: 0, d4: 2}, next: {d1: 2, d2: 0, d3: 0, d4: 2} }
      - { state: {d1: 1, d2: 0, d3: 1, d4: 0}, next: {d1: 2, d2: 0, d3: 1, d4: 0} }
      - { state: {d1: 1, d2: 0, d3: 1, d4: 1}, next: {d1: 1, d2: 2, d3: 1, d4: 1} }
      - { state: {d1: 1, d2: 0, d3: 1, d4: 2}, next: {d1: 0, d2: 0, d3: 1, d4: 2} }
      - { state: {d1: 1, d2: 0, d3: 2, d4: 0}, next: {d1: 0, d2: 0, d3: 2, d4: 0} }
      - { state: {d1: 1, d2: 0, d3: 2, d4: 1}, next: {d1: 2, d2: 0, d3: 2, d4: 1} }
      - { state: {d1: 1, d2: 0, d3: 2, d4: 2}, next: {d1: 1, d2: 2, d3: 2, d4: 2} }
      - { state: {d1: 1, d2: 1, d3: 0, d4: 0}, next: {d1: 0, d2: 1, d3: 0, d4: 0} }
      - { state: {d1: 1, d2: 1, d3: 0, d4: 1}, next: {d1: 2, d2: 1, d3: 0, d4: 1} }
      - { state: {d1: 1, d2: 1, d3: 0, d4: 2}, next: {d1: 1, d2: 1, d3: 2, d4: 2} }
      - { state: {d1: 1, d2: 1, d3: 1, d4: 0}, next: {d1: 1, d2: 1, d3: 1, d4: 2} }
      - { state: {d1: 1, d2: 1, d3: 1, d4: 1}, next: {d1: 0, d2: 1, d3: 1, d4: 1} }
