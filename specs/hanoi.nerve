      - { state: {d1: 1, d2: 2, d3: 1, d4: 1}, next: {d1: 2, d2: 2, d3: 1, d4: 1} }
      - { state: {d1: 1, d2: 2, d3: 1, d4: 2}, next: {d1: 1, d2: 0, d3: 1, d4: 2} }
