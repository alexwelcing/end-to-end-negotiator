      - { state: {d1: 2, d2: 0, d3: 1, d4: 0}, next: {d1: 2, d2: 1, d3: 1, d4: 0} }
      - { state: {d1: 2, d2: 0, d3: 1, d4: 1}, next: {d1: 1, d2: 0, d3: 1, d4: 1} }
      - { state: {d1: 2, d2: 0, d3: 1, d4: 2}, next: {d1: 0, d2: 0, d3: 1, d4: 2} }
      - { state: {d1: 2, d2: 0, d3: 2, d4: 0}, next: {d1: 0, d2: 0, d3: 2, d4: 0} }
      - { state: {d1: 2, d2: 0, d3: 2, d4: 1}, next: {d1: 2, d2: 1, d3: 2, d4: 1} }
      - { state: {d1: 2, d2: 0, d3: 2, d4: 2}, next: {d1: 1, d2: 0, d3: 2, d4: 2} }
      - { state: {d1: 2, d2: 1, d3: 0, d4: 0}, next: {d1: 0, d2: 1, d3: 0, d4: 0} }
      - { state: {d1: 2, d2: 1, d3: 0, d4: 1}, next: {d1: 2, d2: 0, d3: 0, d4: 1} }
