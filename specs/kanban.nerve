# Dragology's kanban board: four cards in three columns (to do, doing, done). A card's slot is
# column * 4 + position. The invariants say no two cards share a slot and every column is packed
# from the top, so 360 of the 20,736 slot tuples are boards. `move_<card>(to)` lifts the card out
# (the cards below close the gap) and drops it at `to` (the cards there make room).
# Generated by `nerve gen kanban` (crates/nerve/src/gen/kanban.rs); edit the generator, not this file.
nerve: 1
name: kanban
state:
  sa: {type: int, range: [0, 11]}   # slot of card a
  sb: {type: int, range: [0, 11]}   # slot of card b
  sc: {type: int, range: [0, 11]}   # slot of card c
  sd: {type: int, range: [0, 11]}   # slot of card d
actions:
  move_a: {params: {to: {type: int, range: [0, 11]}}}
  move_b: {params: {to: {type: int, range: [0, 11]}}}
  move_c: {params: {to: {type: int, range: [0, 11]}}}
  move_d: {params: {to: {type: int, range: [0, 11]}}}
transitions:
  move_a:
    when: "to % 4 <= (int(sb // 4 == to // 4) + int(sc // 4 == to // 4) + int(sd // 4 == to // 4))"
    sa: "to"
    sb: "(sb - 1 if sb // 4 == sa // 4 and sb > sa else sb) + 1 if (sb - 1 if sb // 4 == sa // 4 and sb > sa else sb) // 4 == to // 4 and (sb - 1 if sb // 4 == sa // 4 and sb > sa else sb) >= to else (sb - 1 if sb // 4 == sa // 4 and sb > sa else sb)"
    sc: "(sc - 1 if sc // 4 == sa // 4 and sc > sa else sc) + 1 if (sc - 1 if sc // 4 == sa // 4 and sc > sa else sc) // 4 == to // 4 and (sc - 1 if sc // 4 == sa // 4 and sc > sa else sc) >= to else (sc - 1 if sc // 4 == sa // 4 and sc > sa else sc)"
    sd: "(sd - 1 if sd // 4 == sa // 4 and sd > sa else sd) + 1 if (sd - 1 if sd // 4 == sa // 4 and sd > sa else sd) // 4 == to // 4 and (sd - 1 if sd // 4 == sa // 4 and sd > sa else sd) >= to else (sd - 1 if sd // 4 == sa // 4 and sd > sa else sd)"
    emits: { shipped: "sa // 4 == 2 and old.sa // 4 != 2" }
  move_b:
    when: "to % 4 <= (int(sa // 4 == to // 4) + int(sc // 4 == to // 4) + int(sd // 4 == to // 4))"
    sa: "(sa - 1 if sa // 4 == sb // 4 and sa > sb else sa) + 1 if (sa - 1 if sa // 4 == sb // 4 and sa > sb else sa) // 4 == to // 4 and (sa - 1 if sa // 4 == sb // 4 and sa > sb else sa) >= to else (sa - 1 if sa // 4 == sb // 4 and sa > sb else sa)"
    sb: "to"
    sc: "(sc - 1 if sc // 4 == sb // 4 and sc > sb else sc) + 1 if (sc - 1 if sc // 4 == sb // 4 and sc > sb else sc) // 4 == to // 4 and (sc - 1 if sc // 4 == sb // 4 and sc > sb else sc) >= to else (sc - 1 if sc // 4 == sb // 4 and sc > sb else sc)"
    sd: "(sd - 1 if sd // 4 == sb // 4 and sd > sb else sd) + 1 if (sd - 1 if sd // 4 == sb // 4 and sd > sb else sd) // 4 == to // 4 and (sd - 1 if sd // 4 == sb // 4 and sd > sb else sd) >= to else (sd - 1 if sd // 4 == sb // 4 and sd > sb else sd)"
    emits: { shipped: "sb // 4 == 2 and old.sb // 4 != 2" }
  move_c:
    when: "to % 4 <= (int(sa // 4 == to // 4) + int(sb // 4 == to // 4) + int(sd // 4 == to // 4))"
    sa: "(sa - 1 if sa // 4 == sc // 4 and sa > sc else sa) + 1 if (sa - 1 if sa // 4 == sc // 4 and sa > sc else sa) // 4 == to // 4 and (sa - 1 if sa // 4 == sc // 4 and sa > sc else sa) >= to else (sa - 1 if sa // 4 == sc // 4 and sa > sc else sa)"
    sb: "(sb - 1 if sb // 4 == sc // 4 and sb > sc else sb) + 1 if (sb - 1 if sb // 4 == sc // 4 and sb > sc else sb) // 4 == to // 4 and (sb - 1 if sb // 4 == sc // 4 and sb > sc else sb) >= to else (sb - 1 if sb // 4 == sc // 4 and sb > sc else sb)"
    sc: "to"
    sd: "(sd - 1 if sd // 4 == sc // 4 and sd > sc else sd) + 1 if (sd - 1 if sd // 4 == sc // 4 and sd > sc else sd) // 4 == to // 4 and (sd - 1 if sd // 4 == sc // 4 and sd > sc else sd) >= to else (sd - 1 if sd // 4 == sc // 4 and sd > sc else sd)"
    emits: { shipped: "sc // 4 == 2 and old.sc // 4 != 2" }
  move_d:
    when: "to % 4 <= (int(sa // 4 == to // 4) + int(sb // 4 == to // 4) + int(sc // 4 == to // 4))"
    sa: "(sa - 1 if sa // 4 == sd // 4 and sa > sd else sa) + 1 if (sa - 1 if sa // 4 == sd // 4 and sa > sd else sa) // 4 == to // 4 and (sa - 1 if sa // 4 == sd // 4 and sa > sd else sa) >= to else (sa - 1 if sa // 4 == sd // 4 and sa > sd else sa)"
    sb: "(sb - 1 if sb // 4 == sd // 4 and sb > sd else sb) + 1 if (sb - 1 if sb // 4 == sd // 4 and sb > sd else sb) // 4 == to // 4 and (sb - 1 if sb // 4 == sd // 4 and sb > sd else sb) >= to else (sb - 1 if sb // 4 == sd // 4 and sb > sd else sb)"
    sc: "(sc - 1 if sc // 4 == sd // 4 and sc > sd else sc) + 1 if (sc - 1 if sc // 4 == sd // 4 and sc > sd else sc) // 4 == to // 4 and (sc - 1 if sc // 4 == sd // 4 and sc > sd else sc) >= to else (sc - 1 if sc // 4 == sd // 4 and sc > sd else sc)"
    sd: "to"
    emits: { shipped: "sd // 4 == 2 and old.sd // 4 != 2" }
invariants:
  - "sa != sb and sa != sc and sa != sd and sb != sc and sb != sd and sc != sd"
  - "sa % 4 < (int(sa // 4 == sa // 4) + int(sb // 4 == sa // 4) + int(sc // 4 == sa // 4) + int(sd // 4 == sa // 4)) and sb % 4 < (int(sa // 4 == sb // 4) + int(sb // 4 == sb // 4) + int(sc // 4 == sb // 4) + int(sd // 4 == sb // 4)) and sc % 4 < (int(sa // 4 == sc // 4) + int(sb // 4 == sc // 4) + int(sc // 4 == sc // 4) + int(sd // 4 == sc // 4)) and sd % 4 < (int(sa // 4 == sd // 4) + int(sb // 4 == sd // 4) + int(sc // 4 == sd // 4) + int(sd // 4 == sd // 4))"
ensures:
  - { after: move_a, holds: "sa == to or sa == old.sa" }   # the card lands where it was dropped, or stays
  - { after: move_b, holds: "sb == to or sb == old.sb" }   # the card lands where it was dropped, or stays
  - { after: move_c, holds: "sc == to or sc == old.sc" }   # the card lands where it was dropped, or stays
  - { after: move_d, holds: "sd == to or sd == old.sd" }   # the card lands where it was dropped, or stays
scene:
  box: [-10, 0, 435, 245]
  shapes:
    - {rect: [60, 122, 132, 238], r: 10, color: panel, stroke: line, width: 1.5}
    - {label: to do, at: [60, 16], color: mut, size: 1.8}
    - {rect: [210, 122, 132, 238], r: 10, color: panel, stroke: line, width: 1.5}
    - {label: doing, at: [210, 16], color: mut, size: 1.8}
    - {rect: [360, 122, 132, 238], r: 10, color: panel, stroke: line, width: 1.5}
    - {label: done, at: [360, 16], color: mut, size: 1.8}
render:
  a: { x: "60 + 150 * (sa // 4)", y: "50 + 46 * (sa % 4)", shapes: [{rect: [0, 0, 112, 36], r: 8, color: panel, stroke: ink, width: 1.5}, {label: a, at: [0, 0], color: ink, size: 2.6}] }
  b: { x: "60 + 150 * (sb // 4)", y: "50 + 46 * (sb % 4)", shapes: [{rect: [0, 0, 112, 36], r: 8, color: panel, stroke: ink, width: 1.5}, {label: b, at: [0, 0], color: ink, size: 2.6}] }
  c: { x: "60 + 150 * (sc // 4)", y: "50 + 46 * (sc % 4)", shapes: [{rect: [0, 0, 112, 36], r: 8, color: panel, stroke: ink, width: 1.5}, {label: c, at: [0, 0], color: ink, size: 2.6}] }
  d: { x: "60 + 150 * (sd // 4)", y: "50 + 46 * (sd % 4)", shapes: [{rect: [0, 0, 112, 36], r: 8, color: panel, stroke: ink, width: 1.5}, {label: d, at: [0, 0], color: ink, size: 2.6}] }
futures:
  # one gesture per card: every slot it can be dropped into, in any column
  drag_a: { kind: closest, over: sa, grab: a, action: move_a, stickiness: 6, floating: true }
  drag_b: { kind: closest, over: sb, grab: b, action: move_b, stickiness: 6, floating: true }
  drag_c: { kind: closest, over: sc, grab: c, action: move_c, stickiness: 6, floating: true }
  drag_d: { kind: closest, over: sd, grab: d, action: move_d, stickiness: 6, floating: true }
initial: {sa: 0, sb: 1, sc: 4, sd: 8}
