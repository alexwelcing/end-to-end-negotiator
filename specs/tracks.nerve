# Dragology's "block on tracks": pick a track (closest), then slide along it (vary).
# Nothing in the drag spec says how long a track is or which tracks you can reach.
# Both come from `move`: the middle track is clamped to [60, 180] and a move may only
# change track by one, so the drag finds its futures by asking the oracle.
nerve: 1
name: tracks
state:
  track: {type: int, range: [0, 2]}
  pos:   {type: float, range: [0, 248]}   # the tracks end at 240; the type has slack past the rule, as the rail's does, so a network can reach the end
actions:
  move: {params: {t: {type: int, range: [0, 2]}, to: {type: float, range: [0, 248]}}}
transitions:
  move:
    when: "abs(t - track) <= 1"
    track: "t"
    pos: "clamp(to, 60, 180) if t == 1 else min(to, 240)"
    emits: { exit: "track == 0 and pos >= 232 and old.pos < 232" }   # the block entered the last stretch of the top track (a machine wires it)
invariants:
  - "0 <= pos <= 248"
  - "track != 1 or 60 <= pos <= 180"
ensures:
  - { after: move, holds: "track == t or abs(t - old.track) > 1" }
scene:
  box: [-20, -30, 262, 192]
  shapes:
    - {line: [0, 0, 240, 0], color: track, width: 8}
    - {line: [0, 80, 240, 80], color: track, width: 8}
    - {line: [60, 80, 180, 80], color: ghost, width: 8}
    - {line: [0, 160, 240, 160], color: track, width: 8}
    - {label: '0', at: [0, -16], color: mut, size: 1.8}
    - {label: '60', at: [60, -16], color: mut, size: 1.8}
    - {label: '120', at: [120, -16], color: mut, size: 1.8}
    - {label: '180', at: [180, -16], color: mut, size: 1.8}
    - {label: '240', at: [240, -16], color: mut, size: 1.8}
    - {label: the middle track only reaches from 60 to 180, at: [120, 104], color: mut, size: 1.5}
render:
  block: { x: "pos", y: "80 * track", shape: {rect: [0, 0, 30, 30], r: 7, color: f2, stroke: ink, width: 1.5} }
futures:
  # each: one `vary` per track the oracle can reach; closest picks the track, vary the position
  drag_block:
    kind: closest
    over: track
    grab: block
    stickiness: 8
    far: 60
    floating: true
    each: { kind: vary, over: pos, action: move, param: to }
initial: {track: 0, pos: 0}
