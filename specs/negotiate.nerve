# Homage to the repo this branch grew out of: Deal or No Deal, scaled to a
# finite game. Two agents split 2 books and 2 hats. A proposal is "what I keep".
# `auto` is the move of whichever agent is on turn, shown only by example (one per state, 216):
# open by keeping everything, concede one item a round (a hat, then a book), take any offer that
# leaves you at least half, and walk when the last round's offer does not. A machine pulses `auto`
# every tick and the two sides haggle until they shake hands (`deal`, 4 ticks from the opening state).
# Generated by `nerve gen negotiate` (crates/nerve/src/gen/negotiate.rs); edit the generator, not this file.
nerve: 1
name: negotiate
state:
  turn:   {type: enum, values: [a, b]}
  books:  {type: int, range: [0, 2]}     # books proposer keeps
  hats:   {type: int, range: [0, 2]}     # hats proposer keeps
  status: {type: enum, values: [open, deal, no_deal]}
  rounds: {type: int, range: [0, 3]}
actions:
  propose: {params: {b: {type: int, range: [0, 2]}, h: {type: int, range: [0, 2]}}}
  accept: {}
  walk: {}
  auto: {}   # the agent whose turn it is acts, from a policy shown by examples (see `learn`)
transitions:
  propose:
    when: "status == 'open' and rounds < 3"
    books: "b"
    hats: "h"
    turn: "'b' if turn == 'a' else 'a'"
    rounds: "rounds + 1"
  accept:
    when: "status == 'open' and rounds > 0"
    status: "'deal'"
    emits: { deal: "status == 'deal' and old.status != 'deal'" }
  walk:
    when: "status == 'open'"
    status: "'no_deal'"
  auto:   # the fallback the network is learned on top of: nothing happens; a deal it reaches still emits
    turn: "turn"
    books: "books"
    hats: "hats"
    status: "status"
    rounds: "rounds"
    emits: { deal: "status == 'deal' and old.status != 'deal'" }
invariants:
  - "0 <= books <= 2 and 0 <= hats <= 2"
  - "rounds <= 3"
ensures:
  - { after: propose, holds: "turn != old.turn or old.status != 'open' or old.rounds >= 3" }
  - { after: accept,  holds: "status != 'open' or old.rounds == 0" }
  - { after: auto,    holds: "(turn == old.turn and books == old.books and hats == old.hats and status == old.status and rounds == old.rounds) or (old.status == 'open' and old.rounds < 3 and status == 'open' and turn != old.turn and rounds == old.rounds + 1) or (old.status == 'open' and old.rounds > 0 and status == 'deal' and turn == old.turn and books == old.books and hats == old.hats and rounds == old.rounds) or (old.status == 'open' and status == 'no_deal' and turn == old.turn and books == old.books and hats == old.hats and rounds == old.rounds)" }   # an auto step is a legal propose, accept or walk, or the identity
  - { holds: "status == old.status or old.status == 'open'" }   # terminal states are absorbing
initial: {turn: a, books: 0, hats: 0, status: open, rounds: 0}
scene:
  box: [0, 0, 270, 165]
  shapes:
    - {line: [40, 40, 200, 40], color: track, width: 4}
    - {line: [40, 120, 200, 120], color: track, width: 4}
    - {label: keep 0, at: [40, 66], color: mut, size: 1.6}
    - {label: keep 1, at: [120, 66], color: mut, size: 1.6}
    - {label: keep 2, at: [200, 66], color: mut, size: 1.6}
    - {label: keep 0, at: [40, 146], color: mut, size: 1.6}
    - {label: keep 1, at: [120, 146], color: mut, size: 1.6}
    - {label: keep 2, at: [200, 146], color: mut, size: 1.6}
    - {label: books, at: [240, 40], color: mut, size: 1.8}
    - {label: hats, at: [240, 120], color: mut, size: 1.8}
    - {label: 'turn ', text: turn, at: [70, 155], color: mut, size: 1.6}
    - {text: status, at: [150, 155], color: mut, size: 1.6}
    - {label: 'round ', text: rounds, at: [225, 155], color: mut, size: 1.6}
render:                    # proposal markers on two 0..2 tracks: drag what you want to keep
  books: { x: "40 + 80 * books", y: 40, shapes: [{rect: [0, 0, 44, 34], r: 8, color: panel, stroke: ink, width: 1.5}, {rect: [-8, 2, 10, 20], r: 1, color: f0}, {rect: [3, 4, 10, 16], r: 1, color: f4}, {rect: [13, 0, 8, 24], r: 1, color: f1}] }
  hats:  { x: "40 + 80 * hats", y: 120, shapes: [{rect: [0, 0, 44, 34], r: 8, color: panel, stroke: ink, width: 1.5}, {rect: [0, 8, 32, 5], r: 2, color: ink}, {rect: [0, -3, 18, 18], r: 2, color: ink}] }
futures:
  # each drag is a `propose`; the oracle decides which counts are still legal (open, rounds < 3)
  drag_books: { kind: closest, over: books, grab: books, action: propose, stickiness: 6, far: 70 }
  drag_hats:  { kind: closest, over: hats, grab: hats, action: propose, stickiness: 6, far: 70 }
learn:
  # The policy the two sides play, one example per state: `auto` proposes, accepts or walks for the
  # agent on turn. The spec bounds it (a legal move, or nothing once the table is closed) but never
  # writes it; the `auto` transition above is the fallback.
  - name: play
    action: auto
    examples:
      - { state: {turn: a, books: 0, hats: 0, status: open, rounds: 0}, next: {turn: b, books: 2, hats: 2, status: open, rounds: 1} }
      - { state: {turn: a, books: 0, hats: 0, status: open, rounds: 1}, next: {turn: a, books: 0, hats: 0, status: deal, rounds: 1} }
      - { state: {turn: a, books: 0, hats: 0, status: open, rounds: 2}, next: {turn: a, books: 0, hats: 0, status: deal, rounds: 2} }
      - { state: {turn: a, books: 0, hats: 0, status: open, rounds: 3}, next: {turn: a, books: 0, hats: 0, status: deal, rounds: 3} }
      - { state: {turn: a, books: 0, hats: 0, status: deal, rounds: 0}, next: {turn: a, books: 0, hats: 0, status: deal, rounds: 0} }
      - { state: {turn: a, books: 0, hats: 0, status: deal, rounds: 1}, next: {turn: a, books: 0, hats: 0, status: deal, rounds: 1} }
      - { state: {turn: a, books: 0, hats: 0, status: deal, rounds: 2}, next: {turn: a, books: 0, hats: 0, status: deal, rounds: 2} }
      - { state: {turn: a, books: 0, hats: 0, status: deal, rounds: 3}, next: {turn: a, books: 0, hats: 0, status: deal, rounds: 3} }
      - { state: {turn: a, books: 0, hats: 0, status: no_deal, rounds: 0}, next: {turn: a, books: 0, hats: 0, status: no_deal, rounds: 0} }
      - { state: {turn: a, books: 0, hats: 0, status: no_deal, rounds: 1}, next: {turn: a, books: 0, hats: 0, status: no_deal, rounds: 1} }
      - { state: {turn: a, books: 0, hats: 0, status: no_deal, rounds: 2}, next: {turn: a, books: 0, hats: 0, status: no_deal, rounds: 2} }
      - { state: {turn: a, books: 0, hats: 0, status: no_deal, rounds: 3}, next: {turn: a, books: 0, hats: 0, status: no_deal, rounds: 3} }
      - { state: {turn: a, books: 0, hats: 1, status: open, rounds: 0}, next: {turn: b, books: 2, hats: 2, status: open, rounds: 1} }
      - { state: {turn: a, books: 0, hats: 1, status: open, rounds: 1}, next: {turn: a, books: 0, hats: 1, status: deal, rounds: 1} }
      - { state: {turn: a, books: 0, hats: 1, status: open, rounds: 2}, next: {turn: a, books: 0, hats: 1, status: deal, rounds: 2} }
