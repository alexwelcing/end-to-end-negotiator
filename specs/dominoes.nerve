# Twelve dominoes in a row (docs/rube-goldberg.md, stage 3). `tip` knocks the first over; every `advance`
# fells the next one, left to right; `last_falls` fires as the twelfth goes down. A machine's relay pulses
# `advance` once a tick, so the wave takes eleven ticks to cross.
nerve: 1
name: dominoes
state:
  fallen: {type: int, range: [0, 12]}   # how many have fallen, from the left
actions:
  tip: {}
  advance: {}
  reset: {}
transitions:
  tip: { when: "fallen == 0", fallen: "1" }
  advance:
    when: "fallen > 0 and fallen < 12"
    fallen: "fallen + 1"
    emits: { last_falls: "fallen == 12 and old.fallen == 11" }
  reset: { fallen: "0" }
invariants:
  - "0 <= fallen <= 12"
ensures:
  - { after: advance, holds: "fallen == old.fallen + 1 or old.fallen == 0 or old.fallen == 12" }
  - { after: tip, holds: "fallen == 1 or old.fallen != 0" }
scene:
  box: [-10, -12, 250, 52]
  shapes:
    - {line: [-4, 40, 244, 40], color: line, width: 1.5}
    - {rect: [10, 22, 8, 36], r: 1, color: f3, when: "fallen <= 0"}
    - {rect: [22, 36, 24, 8], r: 1, color: f3, when: "fallen > 0"}
    - {rect: [30, 22, 8, 36], r: 1, color: f3, when: "fallen <= 1"}
    - {rect: [42, 36, 24, 8], r: 1, color: f3, when: "fallen > 1"}
    - {rect: [50, 22, 8, 36], r: 1, color: f3, when: "fallen <= 2"}
    - {rect: [62, 36, 24, 8], r: 1, color: f3, when: "fallen > 2"}
    - {rect: [70, 22, 8, 36], r: 1, color: f3, when: "fallen <= 3"}
    - {rect: [82, 36, 24, 8], r: 1, color: f3, when: "fallen > 3"}
    - {rect: [90, 22, 8, 36], r: 1, color: f3, when: "fallen <= 4"}
    - {rect: [102, 36, 24, 8], r: 1, color: f3, when: "fallen > 4"}
    - {rect: [110, 22, 8, 36], r: 1, color: f3, when: "fallen <= 5"}
    - {rect: [122, 36, 24, 8], r: 1, color: f3, when: "fallen > 5"}
    - {rect: [130, 22, 8, 36], r: 1, color: f3, when: "fallen <= 6"}
    - {rect: [142, 36, 24, 8], r: 1, color: f3, when: "fallen > 6"}
    - {rect: [150, 22, 8, 36], r: 1, color: f3, when: "fallen <= 7"}
    - {rect: [162, 36, 24, 8], r: 1, color: f3, when: "fallen > 7"}
    - {rect: [170, 22, 8, 36], r: 1, color: f3, when: "fallen <= 8"}
    - {rect: [182, 36, 24, 8], r: 1, color: f3, when: "fallen > 8"}
    - {rect: [190, 22, 8, 36], r: 1, color: f3, when: "fallen <= 9"}
    - {rect: [202, 36, 24, 8], r: 1, color: f3, when: "fallen > 9"}
    - {rect: [210, 22, 8, 36], r: 1, color: f3, when: "fallen <= 10"}
    - {rect: [222, 36, 24, 8], r: 1, color: f3, when: "fallen > 10"}
    - {rect: [230, 22, 8, 36], r: 1, color: f3, when: "fallen <= 11"}
    - {rect: [242, 36, 24, 8], r: 1, color: f3, when: "fallen > 11"}
ports:
  tip: [0, 22]
  advance: [120, 52]
  last_falls: [250, 22]
render:
  front: { x: "10 + 20 * fallen", y: 4, shape: {circle: [0, 0, 3], color: acc, when: "fallen > 0 and fallen < 12"} }
initial: {fallen: 0}
