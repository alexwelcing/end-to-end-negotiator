# Dragology's todo list (src/demos/todo.tsx): drag a card to reorder the list, tick its box to complete it.
# The rule: a drag lifts the card out and splices it back in at any index (the cards in between close up
# and make room), and a tick flips that card's `completed` and nothing else. Scaled down: four cards with
# no text. Dragology's text box and Add button need a text type, so cards are not added, typed or renamed;
# Dragology starts with a, b (completed), c, and d stands in for one more card. With no list type
# (ROADMAP 7) a card's place is a position field, so 384 of the 4,096 tuples are lists (24 orders x 16
# completions). The drag is Dragology's `useFloating` variant, closest + floating; its `whenFar(stateWithout)`
# (the list without the card) is not a state here. A completed card is drawn 50 px to the right.
# Generated by `nerve gen todo` (crates/nerve/src/gen/todo.rs); edit the generator, not this file.
nerve: 1
name: todo
state:
  pa: {type: int, range: [0, 3]}   # position of card a, top to bottom
  pb: {type: int, range: [0, 3]}   # position of card b, top to bottom
  pc: {type: int, range: [0, 3]}   # position of card c, top to bottom
  pd: {type: int, range: [0, 3]}   # position of card d, top to bottom
  da: {type: bool}   # card a is completed
  db: {type: bool}   # card b is completed
  dc: {type: bool}   # card c is completed
  dd: {type: bool}   # card d is completed
actions:
  move_a: {params: {to: {type: int, range: [0, 3]}}}   # drag card a to index `to`
  move_b: {params: {to: {type: int, range: [0, 3]}}}   # drag card b to index `to`
  move_c: {params: {to: {type: int, range: [0, 3]}}}   # drag card c to index `to`
  move_d: {params: {to: {type: int, range: [0, 3]}}}   # drag card d to index `to`
  toggle_a: {}   # tick card a's checkbox
  toggle_b: {}   # tick card b's checkbox
  toggle_c: {}   # tick card c's checkbox
  toggle_d: {}   # tick card d's checkbox
transitions:
  move_a:
    pa: "to"
    pb: "pb - 1 if pa < pb <= to else (pb + 1 if to <= pb < pa else pb)"
    pc: "pc - 1 if pa < pc <= to else (pc + 1 if to <= pc < pa else pc)"
    pd: "pd - 1 if pa < pd <= to else (pd + 1 if to <= pd < pa else pd)"
  move_b:
    pa: "pa - 1 if pb < pa <= to else (pa + 1 if to <= pa < pb else pa)"
    pb: "to"
    pc: "pc - 1 if pb < pc <= to else (pc + 1 if to <= pc < pb else pc)"
    pd: "pd - 1 if pb < pd <= to else (pd + 1 if to <= pd < pb else pd)"
  move_c:
    pa: "pa - 1 if pc < pa <= to else (pa + 1 if to <= pa < pc else pa)"
    pb: "pb - 1 if pc < pb <= to else (pb + 1 if to <= pb < pc else pb)"
    pc: "to"
    pd: "pd - 1 if pc < pd <= to else (pd + 1 if to <= pd < pc else pd)"
  move_d:
    pa: "pa - 1 if pd < pa <= to else (pa + 1 if to <= pa < pd else pa)"
    pb: "pb - 1 if pd < pb <= to else (pb + 1 if to <= pb < pd else pb)"
    pc: "pc - 1 if pd < pc <= to else (pc + 1 if to <= pc < pd else pc)"
    pd: "to"
  toggle_a: { da: "not da", emits: { all_done: "da and db and dc and dd and not (old.da and old.db and old.dc and old.dd)" } }
  toggle_b: { db: "not db", emits: { all_done: "da and db and dc and dd and not (old.da and old.db and old.dc and old.dd)" } }
  toggle_c: { dc: "not dc", emits: { all_done: "da and db and dc and dd and not (old.da and old.db and old.dc and old.dd)" } }
  toggle_d: { dd: "not dd", emits: { all_done: "da and db and dc and dd and not (old.da and old.db and old.dc and old.dd)" } }
invariants:
  - "pa != pb and pa != pc and pa != pd and pb != pc and pb != pd and pc != pd"
ensures:
  - { after: move_a, holds: "pa == to and da == old.da and db == old.db and dc == old.dc and dd == old.dd" }   # the card lands where it was dropped, and a drag completes nothing
  - { after: move_b, holds: "pb == to and da == old.da and db == old.db and dc == old.dc and dd == old.dd" }   # the card lands where it was dropped, and a drag completes nothing
  - { after: move_c, holds: "pc == to and da == old.da and db == old.db and dc == old.dc and dd == old.dd" }   # the card lands where it was dropped, and a drag completes nothing
  - { after: move_d, holds: "pd == to and da == old.da and db == old.db and dc == old.dc and dd == old.dd" }   # the card lands where it was dropped, and a drag completes nothing
  - { after: toggle_a, holds: "da != old.da and db == old.db and dc == old.dc and dd == old.dd and pa == old.pa and pb == old.pb and pc == old.pc and pd == old.pd" }   # a tick completes (or reopens) that card only, and never reorders
  - { after: toggle_b, holds: "db != old.db and da == old.da and dc == old.dc and dd == old.dd and pa == old.pa and pb == old.pb and pc == old.pc and pd == old.pd" }   # a tick completes (or reopens) that card only, and never reorders
  - { after: toggle_c, holds: "dc != old.dc and da == old.da and db == old.db and dd == old.dd and pa == old.pa and pb == old.pb and pc == old.pc and pd == old.pd" }   # a tick completes (or reopens) that card only, and never reorders
  - { after: toggle_d, holds: "dd != old.dd and da == old.da and db == old.db and dc == old.dc and pa == old.pa and pb == old.pb and pc == old.pc and pd == old.pd" }   # a tick completes (or reopens) that card only, and never reorders
scene:
  box: [20, 25, 225, 265]
  shapes:
    - {rect: [122, 142, 200, 236], r: 10, color: panel, stroke: line, width: 1.5}
    - {line: [36, 88, 208, 88], color: line, width: 1.5}
    - {line: [36, 143, 208, 143], color: line, width: 1.5}
    - {line: [36, 198, 208, 198], color: line, width: 1.5}
    - {line: [36, 253, 208, 253], color: line, width: 1.5}
    - {label: to do, at: [60, 36], color: mut, size: 1.8}
    - {label: done, at: [110, 36], color: mut, size: 1.8}
render:
  a: { x: "60 + 50 * int(da)", y: "60 + 55 * pa", shapes: [{rect: [30, 0, 120, 40], r: 8, color: panel, stroke: ink, width: 1.5}, {rect: [-14, 0, 18, 18], r: 4, color: none, stroke: mut, width: 1.5, when: "not da"}, {rect: [-14, 0, 18, 18], r: 4, color: f1, when: da}, {label: x, at: [-14, 0], color: white, size: 1.8, when: da}, {label: a, at: [24, 0], color: ink, size: 2.4}, {line: [8, 0, 42, 0], color: mut, width: 2, when: da}] }
  b: { x: "60 + 50 * int(db)", y: "60 + 55 * pb", shapes: [{rect: [30, 0, 120, 40], r: 8, color: panel, stroke: ink, width: 1.5}, {rect: [-14, 0, 18, 18], r: 4, color: none, stroke: mut, width: 1.5, when: "not db"}, {rect: [-14, 0, 18, 18], r: 4, color: f1, when: db}, {label: x, at: [-14, 0], color: white, size: 1.8, when: db}, {label: b, at: [24, 0], color: ink, size: 2.4}, {line: [8, 0, 42, 0], color: mut, width: 2, when: db}] }
  c: { x: "60 + 50 * int(dc)", y: "60 + 55 * pc", shapes: [{rect: [30, 0, 120, 40], r: 8, color: panel, stroke: ink, width: 1.5}, {rect: [-14, 0, 18, 18], r: 4, color: none, stroke: mut, width: 1.5, when: "not dc"}, {rect: [-14, 0, 18, 18], r: 4, color: f1, when: dc}, {label: x, at: [-14, 0], color: white, size: 1.8, when: dc}, {label: c, at: [24, 0], color: ink, size: 2.4}, {line: [8, 0, 42, 0], color: mut, width: 2, when: dc}] }
  d: { x: "60 + 50 * int(dd)", y: "60 + 55 * pd", shapes: [{rect: [30, 0, 120, 40], r: 8, color: panel, stroke: ink, width: 1.5}, {rect: [-14, 0, 18, 18], r: 4, color: none, stroke: mut, width: 1.5, when: "not dd"}, {rect: [-14, 0, 18, 18], r: 4, color: f1, when: dd}, {label: x, at: [-14, 0], color: white, size: 1.8, when: dd}, {label: d, at: [24, 0], color: ink, size: 2.4}, {line: [8, 0, 42, 0], color: mut, width: 2, when: dd}] }
futures:
  # one gesture per card: every index it can be spliced back in at (Dragology's `statesWith`)
  drag_a: { kind: closest, over: pa, grab: a, action: move_a, stickiness: 6, floating: true }
  drag_b: { kind: closest, over: pb, grab: b, action: move_b, stickiness: 6, floating: true }
  drag_c: { kind: closest, over: pc, grab: c, action: move_c, stickiness: 6, floating: true }
  drag_d: { kind: closest, over: pd, grab: d, action: move_d, stickiness: 6, floating: true }
initial: {pa: 0, pb: 1, pc: 2, pd: 3, da: false, db: true, dc: false, dd: false}
