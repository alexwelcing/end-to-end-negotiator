# Dragology's meeting scheduler (src/demos/scheduler.tsx): meetings as bars on a timeline, one track per room.
# The rule: drag a bar to move its meeting to any room; drag the dot at either end to move that end alone,
# never off the timeline and never closer than MIN_LENGTH to the other end. Meetings may overlap, even in
# one room: Dragology draws the overlap graph and marks a double booking in red, it never forbids one (the
# graph is not drawn here, render has points only). Scaled down: 3 meetings (of 5), 2 rooms (of 4), a
# 3-slot timeline (of 250 px) with ends on whole slots and a one-slot minimum, so 1,728 of the 5,832 tuples
# are schedules. On the grid an end's `vary` becomes `closest` over its slot; the bar's drag is `between`.
# Each meeting has its own row inside a room's band so that no two handles ever coincide.
# Generated by scripts/gen_scheduler_spec.py; edit the script, not this file.
nerve: 1
name: scheduler
state:
  room0: {type: int, range: [0, 1]}   # meeting 0's room
  start0: {type: int, range: [0, 2]}   # meeting 0 starts at this slot
  end0: {type: int, range: [1, 3]}   # ... and ends at this one
  room1: {type: int, range: [0, 1]}   # meeting 1's room
  start1: {type: int, range: [0, 2]}   # meeting 1 starts at this slot
  end1: {type: int, range: [1, 3]}   # ... and ends at this one
  room2: {type: int, range: [0, 1]}   # meeting 2's room
  start2: {type: int, range: [0, 2]}   # meeting 2 starts at this slot
  end2: {type: int, range: [1, 3]}   # ... and ends at this one
actions:
  set_room0: {params: {to: {type: int, range: [0, 1]}}}   # drag meeting 0's bar
  set_start0: {params: {to: {type: int, range: [0, 2]}}}   # drag its left dot
  set_end0: {params: {to: {type: int, range: [1, 3]}}}   # drag its right dot
  set_room1: {params: {to: {type: int, range: [0, 1]}}}   # drag meeting 1's bar
  set_start1: {params: {to: {type: int, range: [0, 2]}}}   # drag its left dot
  set_end1: {params: {to: {type: int, range: [1, 3]}}}   # drag its right dot
  set_room2: {params: {to: {type: int, range: [0, 1]}}}   # drag meeting 2's bar
  set_start2: {params: {to: {type: int, range: [0, 2]}}}   # drag its left dot
  set_end2: {params: {to: {type: int, range: [1, 3]}}}   # drag its right dot
transitions:
  set_room0: { room0: "to" }
  set_start0: { when: "to + 1 <= end0", start0: "to" }
  set_end0: { when: "start0 + 1 <= to", end0: "to" }
  set_room1: { room1: "to" }
  set_start1: { when: "to + 1 <= end1", start1: "to" }
  set_end1: { when: "start1 + 1 <= to", end1: "to" }
  set_room2: { room2: "to" }
  set_start2: { when: "to + 1 <= end2", start2: "to" }
  set_end2: { when: "start2 + 1 <= to", end2: "to" }
invariants:
  # Dragology's vary constraints: lessThan(0, start), lessThan(start, end - MIN_LENGTH), lessThan(end, END_TIME)
  - "0 <= start0 and start0 + 1 <= end0 <= 3"
  - "0 <= start1 and start1 + 1 <= end1 <= 3"
  - "0 <= start2 and start2 + 1 <= end2 <= 3"
ensures:
  - { after: set_room0, holds: "room0 == to and start0 == old.start0 and end0 == old.end0 and room1 == old.room1 and start1 == old.start1 and end1 == old.end1 and room2 == old.room2 and start2 == old.start2 and end2 == old.end2" }   # the meeting changes room, keeps its time, and no other meeting moves
  - { after: set_start0, holds: "(start0 == to or start0 == old.start0) and room0 == old.room0 and end0 == old.end0 and room1 == old.room1 and start1 == old.start1 and end1 == old.end1 and room2 == old.room2 and start2 == old.start2 and end2 == old.end2" }   # only that end moves
  - { after: set_end0, holds: "(end0 == to or end0 == old.end0) and room0 == old.room0 and start0 == old.start0 and room1 == old.room1 and start1 == old.start1 and end1 == old.end1 and room2 == old.room2 and start2 == old.start2 and end2 == old.end2" }   # only that end moves
  - { after: set_room1, holds: "room1 == to and start1 == old.start1 and end1 == old.end1 and room0 == old.room0 and start0 == old.start0 and end0 == old.end0 and room2 == old.room2 and start2 == old.start2 and end2 == old.end2" }   # the meeting changes room, keeps its time, and no other meeting moves
  - { after: set_start1, holds: "(start1 == to or start1 == old.start1) and room1 == old.room1 and end1 == old.end1 and room0 == old.room0 and start0 == old.start0 and end0 == old.end0 and room2 == old.room2 and start2 == old.start2 and end2 == old.end2" }   # only that end moves
  - { after: set_end1, holds: "(end1 == to or end1 == old.end1) and room1 == old.room1 and start1 == old.start1 and room0 == old.room0 and start0 == old.start0 and end0 == old.end0 and room2 == old.room2 and start2 == old.start2 and end2 == old.end2" }   # only that end moves
  - { after: set_room2, holds: "room2 == to and start2 == old.start2 and end2 == old.end2 and room0 == old.room0 and start0 == old.start0 and end0 == old.end0 and room1 == old.room1 and start1 == old.start1 and end1 == old.end1" }   # the meeting changes room, keeps its time, and no other meeting moves
  - { after: set_start2, holds: "(start2 == to or start2 == old.start2) and room2 == old.room2 and end2 == old.end2 and room0 == old.room0 and start0 == old.start0 and end0 == old.end0 and room1 == old.room1 and start1 == old.start1 and end1 == old.end1" }   # only that end moves
  - { after: set_end2, holds: "(end2 == to or end2 == old.end2) and room2 == old.room2 and start2 == old.start2 and room0 == old.room0 and start0 == old.start0 and end0 == old.end0 and room1 == old.room1 and start1 == old.start1 and end1 == old.end1" }   # only that end moves
render:
  bar0: { x: "60 + 50 * (start0 + end0)", y: "40 + 170 * room0" }   # middle of the bar
  left0: { x: "60 + 100 * start0", y: "40 + 170 * room0" }
  right0: { x: "60 + 100 * end0", y: "40 + 170 * room0" }
  bar1: { x: "60 + 50 * (start1 + end1)", y: "88 + 170 * room1" }   # middle of the bar
  left1: { x: "60 + 100 * start1", y: "88 + 170 * room1" }
  right1: { x: "60 + 100 * end1", y: "88 + 170 * room1" }
  bar2: { x: "60 + 50 * (start2 + end2)", y: "136 + 170 * room2" }   # middle of the bar
  left2: { x: "60 + 100 * start2", y: "136 + 170 * room2" }
  right2: { x: "60 + 100 * end2", y: "136 + 170 * room2" }
futures:
  # per meeting: the bar goes to any room (Dragology `between`, no snap radius here); each dot to every slot
  # its end may take (Dragology `vary` with constraints, on the slot grid)
  drag_bar0: { kind: between, over: room0, grab: bar0, action: set_room0 }
  drag_left0: { kind: closest, over: start0, grab: left0, action: set_start0, stickiness: 6 }
  drag_right0: { kind: closest, over: end0, grab: right0, action: set_end0, stickiness: 6 }
  drag_bar1: { kind: between, over: room1, grab: bar1, action: set_room1 }
  drag_left1: { kind: closest, over: start1, grab: left1, action: set_start1, stickiness: 6 }
  drag_right1: { kind: closest, over: end1, grab: right1, action: set_end1, stickiness: 6 }
  drag_bar2: { kind: between, over: room2, grab: bar2, action: set_room2 }
  drag_left2: { kind: closest, over: start2, grab: left2, action: set_start2, stickiness: 6 }
  drag_right2: { kind: closest, over: end2, grab: right2, action: set_end2, stickiness: 6 }
initial: {room0: 0, start0: 0, end0: 2, room1: 1, start1: 1, end1: 3, room2: 1, start2: 0, end2: 1}
