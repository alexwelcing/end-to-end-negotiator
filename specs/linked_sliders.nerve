# Dragology's linked-sliders (src/demos/linked-sliders.tsx): a stack of sliders on tracks.
# Rule: dragging slider i moves it and every slider below it by the same amount, and the whole group
# stops as soon as any of them reaches an end of its track (`d.varyFunc` with an `inOrder([0, v, W])`
# constraint on every value). Scaled down from five sliders to three; vertical spacing 36 -> 40 px.
# `set_<i>(to)` asks for slider i at `to` and moves the group by `to - v_i`, clamped to keep it on the tracks.
# Generated by scripts/gen_linked_sliders_spec.py; edit the script, not this file.
nerve: 1
name: linked_sliders
state:
  v1: {type: float, range: [0, 240]}   # slider 1
  v2: {type: float, range: [0, 240]}   # slider 2
  v3: {type: float, range: [0, 240]}   # slider 3
actions:
  set_1: {params: {to: {type: float, range: [0, 240]}}}
  set_2: {params: {to: {type: float, range: [0, 240]}}}
  set_3: {params: {to: {type: float, range: [0, 240]}}}
transitions:
  set_1:
    v1: "clamp(v1 + clamp(to - v1, -min(v1, v2, v3), 240 - max(v1, v2, v3)), 0, 240)"
    v2: "clamp(v2 + clamp(to - v1, -min(v1, v2, v3), 240 - max(v1, v2, v3)), 0, 240)"
    v3: "clamp(v3 + clamp(to - v1, -min(v1, v2, v3), 240 - max(v1, v2, v3)), 0, 240)"
  set_2:
    v2: "clamp(v2 + clamp(to - v2, -min(v2, v3), 240 - max(v2, v3)), 0, 240)"
    v3: "clamp(v3 + clamp(to - v2, -min(v2, v3), 240 - max(v2, v3)), 0, 240)"
  set_3:
    v3: "clamp(v3 + clamp(to - v3, -v3, 240 - v3), 0, 240)"
invariants:
  - "0 <= v1 <= 240 and 0 <= v2 <= 240 and 0 <= v3 <= 240"
ensures:
  - { after: set_1, holds: "abs((v2 - v1) - (old.v2 - old.v1)) < 0.001" }   # v2 moves with v1
  - { after: set_1, holds: "abs((v3 - v1) - (old.v3 - old.v1)) < 0.001" }   # v3 moves with v1
  - { after: set_1, holds: "abs(v1 - to) < 0.001 or (to > old.v1 and max(v1, v2, v3) == 240) or (to < old.v1 and min(v1, v2, v3) == 0)" }   # it reaches `to`, or the group is at an end
  - { after: set_2, holds: "v1 == old.v1" }   # the sliders above do not move
  - { after: set_2, holds: "abs((v3 - v2) - (old.v3 - old.v2)) < 0.001" }   # v3 moves with v2
  - { after: set_2, holds: "abs(v2 - to) < 0.001 or (to > old.v2 and max(v2, v3) == 240) or (to < old.v2 and min(v2, v3) == 0)" }   # it reaches `to`, or the group is at an end
  - { after: set_3, holds: "v1 == old.v1 and v2 == old.v2" }   # the sliders above do not move
  - { after: set_3, holds: "abs(v3 - to) < 0.001 or (to > old.v3 and v3 == 240) or (to < old.v3 and v3 == 0)" }   # it reaches `to`, or the group is at an end
render:
  thumb1: { x: "40 + v1", y: 30 }
  thumb2: { x: "40 + v2", y: 70 }
  thumb3: { x: "40 + v3", y: 110 }
futures:
  # one vary per thumb, realised through its own set_<i> so the group moves and the clamp applies
  drag_1: { kind: vary, over: v1, grab: thumb1, action: set_1, param: to }
  drag_2: { kind: vary, over: v2, grab: thumb2, action: set_2, param: to }
  drag_3: { kind: vary, over: v3, grab: thumb3, action: set_3, param: to }
initial: {v1: 60.0, v2: 120.0, v3: 180.0}
