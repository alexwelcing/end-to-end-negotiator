# One decimal digit: the block an odometer is made of (docs/machine-room.md, paper 2 §3.4).
# `inc` counts and emits `wrap` when it rolls over from 9 to 0; the machine wires that event
# to the next digit's `inc`. The digit knows nothing about its neighbours.
nerve: 1
name: digit
state:
  d: {type: int, range: [0, 9]}
actions:
  inc: {}
  reset: {}
transitions:
  inc:   { d: "(d + 1) % 10", emits: { wrap: "old.d == 9" } }
  reset: { d: "0" }
ensures:
  - { after: inc, holds: "d == (old.d + 1) % 10" }
  - { after: reset, holds: "d == 0" }
ports:
  inc: [0, 40]      # a machine's wires: counts come in on the left,
  wrap: [60, 40]    # the carry leaves on the right,
  reset: [30, 80]   # a reset arrives from below
scene:
  box: [0, 0, 60, 80]
  shapes:
    - {rect: [30, 40, 48, 64], r: 8, color: ink}
render:
  face: { x: 30, y: 40, shape: {text: d, at: [0, 0], color: ok, size: 6} }
initial: {d: 0}
