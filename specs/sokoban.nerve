# Dragology's sokoban: drag the player one cell onto floor; a box in the way is pushed one cell
# further, but only onto floor with no box on it. Only the player is draggable.
# Scaled down: Dragology's 8 x 9 level with seven boxes is too big to enumerate, so this is its top
# three rows (first two boxes and goals, player where Dragology puts it), walled off below:
#
#   #######
#   ###   #
#   #gpb  #
#   ### bg#
#   #######
#
# Each object is one cell number, y * 5 + x over the interior (5 x 3, `##` = wall):
#
#   ## ##  2  3  4
#    5  6  7  8  9
#   ## ## 12 13 14
#
# Goals: cells 5 and 14 (the demo draws them and has no win condition, so they are
# not state). Boxes b1, b2 are Dragology's box objects in reading order. One drag is one step:
# Dragology's `chain: true` (keep walking within one drag) has no Nerve counterpart yet.
# 3,375 cell tuples, 990 of them boards (every object on floor, none sharing a cell).
# Generated by `nerve gen sokoban` (crates/nerve/src/gen/sokoban.rs); edit the generator, not this file.
nerve: 1
name: sokoban
state:
  p: {type: int, range: [0, 14]}    # player's cell
  b1: {type: int, range: [0, 14]}   # cell of box 1
  b2: {type: int, range: [0, 14]}   # cell of box 2
actions:
  move: {params: {dir: {type: enum, values: [left, right, up, down]}}}
transitions:
  move:
    when: "(p % 5 >= 1 and p != 1 and p != 2 and p != 11 and p != 12 and (not (b1 == p - 1 or b2 == p - 1) or (p % 5 >= 2 and p != 2 and p != 3 and p != 12 and p != 13 and b1 != p - 2 and b2 != p - 2))) if dir == 'left' else (p % 5 <= 3 and p != 0 and p != 9 and p != 10 and (not (b1 == p + 1 or b2 == p + 1) or (p % 5 <= 2 and p != 8 and p != 9 and b1 != p + 2 and b2 != p + 2))) if dir == 'right' else (p >= 5 and p != 5 and p != 6 and (not (b1 == p - 5 or b2 == p - 5) or (p >= 10 and p != 10 and p != 11 and b1 != p - 10 and b2 != p - 10))) if dir == 'up' else (p <= 9 and p != 5 and p != 6 and (not (b1 == p + 5 or b2 == p + 5) or (p <= 4 and p != 0 and p != 1 and b1 != p + 10 and b2 != p + 10)))"
    p: "p - 1 if dir == 'left' else p + 1 if dir == 'right' else p - 5 if dir == 'up' else p + 5"
    b1: "(p - 2 if b1 == p - 1 else b1) if dir == 'left' else (p + 2 if b1 == p + 1 else b1) if dir == 'right' else (p - 10 if b1 == p - 5 else b1) if dir == 'up' else (p + 10 if b1 == p + 5 else b1)"
    b2: "(p - 2 if b2 == p - 1 else b2) if dir == 'left' else (p + 2 if b2 == p + 1 else b2) if dir == 'right' else (p - 10 if b2 == p - 5 else b2) if dir == 'up' else (p + 10 if b2 == p + 5 else b2)"
invariants:
  - "p != 0 and p != 1 and p != 10 and p != 11 and b1 != 0 and b1 != 1 and b1 != 10 and b1 != 11 and b2 != 0 and b2 != 1 and b2 != 10 and b2 != 11"   # nothing stands on a wall
  - "p != b1 and p != b2 and b1 != b2"   # one object per cell
ensures:
  - { after: move, holds: "p == old.p or (p - old.p == (-1 if dir == 'left' else 1 if dir == 'right' else -5 if dir == 'up' else 5) and (p // 5 == old.p // 5 or p % 5 == old.p % 5))" }   # one step the dragged way, never wrapping a row
  - { after: move, holds: "b1 == old.b1 or (b1 - old.b1 == p - old.p and p == old.b1)" }   # b1 moves only when pushed, the way the player went
  - { after: move, holds: "b2 == old.b2 or (b2 - old.b2 == p - old.p and p == old.b2)" }   # b2 moves only when pushed, the way the player went
scene:
  box: [14, 14, 326, 206]
  shapes:
    - {rect: [170, 110, 300, 180], r: 6, color: panel, stroke: line, width: 1.5}
    - {line: [80, 20, 80, 200], color: line, width: 1.5}
    - {line: [140, 20, 140, 200], color: line, width: 1.5}
    - {line: [200, 20, 200, 200], color: line, width: 1.5}
    - {line: [260, 20, 260, 200], color: line, width: 1.5}
    - {line: [20, 80, 320, 80], color: line, width: 1.5}
    - {line: [20, 140, 320, 140], color: line, width: 1.5}
    - {rect: [50, 50, 58, 58], r: 2, color: track}
    - {rect: [110, 50, 58, 58], r: 2, color: track}
    - {rect: [50, 170, 58, 58], r: 2, color: track}
    - {rect: [110, 170, 58, 58], r: 2, color: track}
    - {circle: [50, 110, 14], color: none, stroke: f1, width: 2}
    - {circle: [290, 170, 14], color: none, stroke: f1, width: 2}
render:
  player: { x: "50 + 60 * (p % 5)", y: "50 + 60 * (p // 5)", shapes: [{circle: [0, 0, 17], color: f0, stroke: acc, width: 2}, {label: you, at: [0, 0], color: white, size: 1.6}] }
  box1: { x: "50 + 60 * (b1 % 5)", y: "50 + 60 * (b1 // 5)", shapes: [{rect: [0, 0, 44, 44], r: 5, color: f9, when: "not (b1 == 5 or b1 == 14)"}, {rect: [0, 0, 44, 44], r: 5, color: f1, when: "b1 == 5 or b1 == 14"}, {rect: [0, 0, 44, 44], r: 5, color: none, stroke: ink, width: 1.5}, {line: [-14, -14, 14, 14], color: white, width: 2, opacity: 0.5}, {line: [14, -14, -14, 14], color: white, width: 2, opacity: 0.5}] }
  box2: { x: "50 + 60 * (b2 % 5)", y: "50 + 60 * (b2 // 5)", shapes: [{rect: [0, 0, 44, 44], r: 5, color: f9, when: "not (b2 == 5 or b2 == 14)"}, {rect: [0, 0, 44, 44], r: 5, color: f1, when: "b2 == 5 or b2 == 14"}, {rect: [0, 0, 44, 44], r: 5, color: none, stroke: ink, width: 1.5}, {line: [-14, -14, 14, 14], color: white, width: 2, opacity: 0.5}, {line: [14, -14, -14, 14], color: white, width: 2, opacity: 0.5}] }
futures:
  # Dragology: closest over the four neighbouring moves (and staying); the guard decides which exist
  drag_player: { kind: closest, over: p, grab: player, action: move, stickiness: 6 }
initial: {p: 6, b1: 7, b2: 13}
