# Dragology's insert-and-remove: fruit tiles in a list under a toolbar. Drag a tile to any place
# in the list (the rest make room) or to the trash; pull one from the toolbar into any place, or
# let it go back. Far from every option (whenFar, 50 px) the drag falls back to where it began.
# Scaled down: four tiles with fixed identities instead of an unbounded list and a toolbar that
# mints new ones. a, b = apple and c = banana (Dragology's starting list), d = grapes. A tile's
# field is its list index, or 4 = out of the list, drawn in its own toolbar slot: that slot is both
# Dragology's store (pull from it) and its trash (drop on it). The invariants say the tiles in the
# list are packed from index 0 with none sharing one, so 65 of the 625 index tuples are
# lists. `move_<tile>(to)` lifts the tile out (the ones after it close up) and inserts it at `to`.
# Generated by scripts/gen_insert_remove_spec.py; edit the script, not this file.
nerve: 1
name: insert_remove
state:
  pa: {type: int, range: [0, 4]}   # list index of tile a (apple); 4 = in the toolbar
  pb: {type: int, range: [0, 4]}   # list index of tile b (apple); 4 = in the toolbar
  pc: {type: int, range: [0, 4]}   # list index of tile c (banana); 4 = in the toolbar
  pd: {type: int, range: [0, 4]}   # list index of tile d (grapes); 4 = in the toolbar
actions:
  move_a: {params: {to: {type: int, range: [0, 4]}}}   # drop a at list index `to`, or 4: remove it
  move_b: {params: {to: {type: int, range: [0, 4]}}}   # drop b at list index `to`, or 4: remove it
  move_c: {params: {to: {type: int, range: [0, 4]}}}   # drop c at list index `to`, or 4: remove it
  move_d: {params: {to: {type: int, range: [0, 4]}}}   # drop d at list index `to`, or 4: remove it
transitions:
  move_a:
    when: "to == 4 or to <= (int(pb < 4) + int(pc < 4) + int(pd < 4))"
    pa: "to"
    pb: "(pb - 1 if pa < pb < 4 else pb) + 1 if to <= (pb - 1 if pa < pb < 4 else pb) < 4 else (pb - 1 if pa < pb < 4 else pb)"
    pc: "(pc - 1 if pa < pc < 4 else pc) + 1 if to <= (pc - 1 if pa < pc < 4 else pc) < 4 else (pc - 1 if pa < pc < 4 else pc)"
    pd: "(pd - 1 if pa < pd < 4 else pd) + 1 if to <= (pd - 1 if pa < pd < 4 else pd) < 4 else (pd - 1 if pa < pd < 4 else pd)"
  move_b:
    when: "to == 4 or to <= (int(pa < 4) + int(pc < 4) + int(pd < 4))"
    pa: "(pa - 1 if pb < pa < 4 else pa) + 1 if to <= (pa - 1 if pb < pa < 4 else pa) < 4 else (pa - 1 if pb < pa < 4 else pa)"
    pb: "to"
    pc: "(pc - 1 if pb < pc < 4 else pc) + 1 if to <= (pc - 1 if pb < pc < 4 else pc) < 4 else (pc - 1 if pb < pc < 4 else pc)"
    pd: "(pd - 1 if pb < pd < 4 else pd) + 1 if to <= (pd - 1 if pb < pd < 4 else pd) < 4 else (pd - 1 if pb < pd < 4 else pd)"
  move_c:
    when: "to == 4 or to <= (int(pa < 4) + int(pb < 4) + int(pd < 4))"
    pa: "(pa - 1 if pc < pa < 4 else pa) + 1 if to <= (pa - 1 if pc < pa < 4 else pa) < 4 else (pa - 1 if pc < pa < 4 else pa)"
    pb: "(pb - 1 if pc < pb < 4 else pb) + 1 if to <= (pb - 1 if pc < pb < 4 else pb) < 4 else (pb - 1 if pc < pb < 4 else pb)"
    pc: "to"
    pd: "(pd - 1 if pc < pd < 4 else pd) + 1 if to <= (pd - 1 if pc < pd < 4 else pd) < 4 else (pd - 1 if pc < pd < 4 else pd)"
  move_d:
    when: "to == 4 or to <= (int(pa < 4) + int(pb < 4) + int(pc < 4))"
    pa: "(pa - 1 if pd < pa < 4 else pa) + 1 if to <= (pa - 1 if pd < pa < 4 else pa) < 4 else (pa - 1 if pd < pa < 4 else pa)"
    pb: "(pb - 1 if pd < pb < 4 else pb) + 1 if to <= (pb - 1 if pd < pb < 4 else pb) < 4 else (pb - 1 if pd < pb < 4 else pb)"
    pc: "(pc - 1 if pd < pc < 4 else pc) + 1 if to <= (pc - 1 if pd < pc < 4 else pc) < 4 else (pc - 1 if pd < pc < 4 else pc)"
    pd: "to"
invariants:
  - "(pa == 4 or pa != pb) and (pa == 4 or pa != pc) and (pa == 4 or pa != pd) and (pb == 4 or pb != pc) and (pb == 4 or pb != pd) and (pc == 4 or pc != pd)"   # no two tiles share an index
  - "(pa == 4 or pa < (int(pa < 4) + int(pb < 4) + int(pc < 4) + int(pd < 4))) and (pb == 4 or pb < (int(pa < 4) + int(pb < 4) + int(pc < 4) + int(pd < 4))) and (pc == 4 or pc < (int(pa < 4) + int(pb < 4) + int(pc < 4) + int(pd < 4))) and (pd == 4 or pd < (int(pa < 4) + int(pb < 4) + int(pc < 4) + int(pd < 4)))"   # the list is packed from index 0
ensures:
  - { after: move_a, holds: "pa == to or pa == old.pa" }   # the tile lands where it was dropped, or stays
  - { after: move_b, holds: "pb == to or pb == old.pb" }   # the tile lands where it was dropped, or stays
  - { after: move_c, holds: "pc == to or pc == old.pc" }   # the tile lands where it was dropped, or stays
  - { after: move_d, holds: "pd == to or pd == old.pd" }   # the tile lands where it was dropped, or stays
  - { after: move_a, holds: "(pb == 4) == (old.pb == 4) and (pc == 4) == (old.pc == 4) and (pd == 4) == (old.pd == 4) and (old.pb == 4 or old.pc == 4 or (pb < pc) == (old.pb < old.pc)) and (old.pb == 4 or old.pd == 4 or (pb < pd) == (old.pb < old.pd)) and (old.pc == 4 or old.pd == 4 or (pc < pd) == (old.pc < old.pd))" }   # nothing else joins or leaves, and the rest keep their order
  - { after: move_b, holds: "(pa == 4) == (old.pa == 4) and (pc == 4) == (old.pc == 4) and (pd == 4) == (old.pd == 4) and (old.pa == 4 or old.pc == 4 or (pa < pc) == (old.pa < old.pc)) and (old.pa == 4 or old.pd == 4 or (pa < pd) == (old.pa < old.pd)) and (old.pc == 4 or old.pd == 4 or (pc < pd) == (old.pc < old.pd))" }   # nothing else joins or leaves, and the rest keep their order
  - { after: move_c, holds: "(pa == 4) == (old.pa == 4) and (pb == 4) == (old.pb == 4) and (pd == 4) == (old.pd == 4) and (old.pa == 4 or old.pb == 4 or (pa < pb) == (old.pa < old.pb)) and (old.pa == 4 or old.pd == 4 or (pa < pd) == (old.pa < old.pd)) and (old.pb == 4 or old.pd == 4 or (pb < pd) == (old.pb < old.pd))" }   # nothing else joins or leaves, and the rest keep their order
  - { after: move_d, holds: "(pa == 4) == (old.pa == 4) and (pb == 4) == (old.pb == 4) and (pc == 4) == (old.pc == 4) and (old.pa == 4 or old.pb == 4 or (pa < pb) == (old.pa < old.pb)) and (old.pa == 4 or old.pc == 4 or (pa < pc) == (old.pa < old.pc)) and (old.pb == 4 or old.pc == 4 or (pb < pc) == (old.pb < old.pc))" }   # nothing else joins or leaves, and the rest keep their order
render:
  a: { x: "30 + 50 * (0 if pa == 4 else pa)", y: "30 if pa == 4 else 110" }
  b: { x: "30 + 50 * (1 if pb == 4 else pb)", y: "30 if pb == 4 else 110" }
  c: { x: "30 + 50 * (2 if pc == 4 else pc)", y: "30 if pc == 4 else 110" }
  d: { x: "30 + 50 * (3 if pd == 4 else pd)", y: "30 if pd == 4 else 110" }
futures:
  # one gesture per tile: every list index it can be dropped at, or its toolbar slot (out)
  drag_a: { kind: closest, over: pa, grab: a, action: move_a, stickiness: 6, far: 50, floating: true }
  drag_b: { kind: closest, over: pb, grab: b, action: move_b, stickiness: 6, far: 50, floating: true }
  drag_c: { kind: closest, over: pc, grab: c, action: move_c, stickiness: 6, far: 50, floating: true }
  drag_d: { kind: closest, over: pd, grab: d, action: move_d, stickiness: 6, far: 50, floating: true }
initial: {pa: 0, pb: 1, pc: 2, pd: 4}
