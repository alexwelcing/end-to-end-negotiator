# Dragology's reorderable list: five items, drag one to a new place and the others make room.
# There is no list type yet (ROADMAP 7), so the list is one position per item and an invariant
# that no two share a place. `move` is Dragology's moveItem(items, i, j): the drag's futures are
# every order one move away, derived from this rule instead of written out by hand.
# Generated by `nerve gen reorder` (crates/nerve/src/gen/reorder.rs); edit the generator, not this file.
nerve: 1
name: reorder
state:
  pa: {type: int, range: [0, 4]}   # position of item a
  pb: {type: int, range: [0, 4]}   # position of item b
  pc: {type: int, range: [0, 4]}   # position of item c
  pd: {type: int, range: [0, 4]}   # position of item d
  pe: {type: int, range: [0, 4]}   # position of item e
actions:
  move: {params: {item: {type: enum, values: [a, b, c, d, e]}, to: {type: int, range: [0, 4]}}}
transitions:
  move:
    pa: "to if item == 'a' else (pa - 1 if (pa if item == 'a' else pb if item == 'b' else pc if item == 'c' else pd if item == 'd' else pe) < pa <= to else (pa + 1 if to <= pa < (pa if item == 'a' else pb if item == 'b' else pc if item == 'c' else pd if item == 'd' else pe) else pa))"
    pb: "to if item == 'b' else (pb - 1 if (pa if item == 'a' else pb if item == 'b' else pc if item == 'c' else pd if item == 'd' else pe) < pb <= to else (pb + 1 if to <= pb < (pa if item == 'a' else pb if item == 'b' else pc if item == 'c' else pd if item == 'd' else pe) else pb))"
    pc: "to if item == 'c' else (pc - 1 if (pa if item == 'a' else pb if item == 'b' else pc if item == 'c' else pd if item == 'd' else pe) < pc <= to else (pc + 1 if to <= pc < (pa if item == 'a' else pb if item == 'b' else pc if item == 'c' else pd if item == 'd' else pe) else pc))"
    pd: "to if item == 'd' else (pd - 1 if (pa if item == 'a' else pb if item == 'b' else pc if item == 'c' else pd if item == 'd' else pe) < pd <= to else (pd + 1 if to <= pd < (pa if item == 'a' else pb if item == 'b' else pc if item == 'c' else pd if item == 'd' else pe) else pd))"
    pe: "to if item == 'e' else (pe - 1 if (pa if item == 'a' else pb if item == 'b' else pc if item == 'c' else pd if item == 'd' else pe) < pe <= to else (pe + 1 if to <= pe < (pa if item == 'a' else pb if item == 'b' else pc if item == 'c' else pd if item == 'd' else pe) else pe))"
    emits: { home: "pa == 0 and pb == 1 and pc == 2 and pd == 3 and pe == 4 and not (old.pa == 0 and old.pb == 1 and old.pc == 2 and old.pd == 3 and old.pe == 4)" }
invariants:
  - "pa != pb and pa != pc and pa != pd and pa != pe and pb != pc and pb != pd and pb != pe and pc != pd and pc != pe and pd != pe"
ensures:
  - { after: move, holds: "(pa if item == 'a' else pb if item == 'b' else pc if item == 'c' else pd if item == 'd' else pe) == to" }   # the moved item lands where it was dropped
ports:
  move: [0, 40]     # a machine's wire into the list
  home: [330, 40]   # and out of it
scene:
  box: [0, 0, 330, 80]
  shapes:
    - {rect: [168, 40, 316, 68], r: 10, color: panel, stroke: line, width: 1.5}
    - {rect: [40, 40, 54, 54], r: 8, color: none, stroke: line, width: 1.5}
    - {rect: [104, 40, 54, 54], r: 8, color: none, stroke: line, width: 1.5}
    - {rect: [168, 40, 54, 54], r: 8, color: none, stroke: line, width: 1.5}
    - {rect: [232, 40, 54, 54], r: 8, color: none, stroke: line, width: 1.5}
    - {rect: [296, 40, 54, 54], r: 8, color: none, stroke: line, width: 1.5}
render:
  a: { x: "40 + 64 * pa", y: 40, shapes: [{rect: [0, 0, 50, 50], r: 8, color: panel, stroke: ink, width: 1.5}, {label: a, at: [0, 0], color: ink, size: 2.6}] }
  b: { x: "40 + 64 * pb", y: 40, shapes: [{rect: [0, 0, 50, 50], r: 8, color: panel, stroke: ink, width: 1.5}, {label: b, at: [0, 0], color: ink, size: 2.6}] }
  c: { x: "40 + 64 * pc", y: 40, shapes: [{rect: [0, 0, 50, 50], r: 8, color: panel, stroke: ink, width: 1.5}, {label: c, at: [0, 0], color: ink, size: 2.6}] }
  d: { x: "40 + 64 * pd", y: 40, shapes: [{rect: [0, 0, 50, 50], r: 8, color: panel, stroke: ink, width: 1.5}, {label: d, at: [0, 0], color: ink, size: 2.6}] }
  e: { x: "40 + 64 * pe", y: 40, shapes: [{rect: [0, 0, 50, 50], r: 8, color: panel, stroke: ink, width: 1.5}, {label: e, at: [0, 0], color: ink, size: 2.6}] }
futures:
  # one gesture per item: grab it, and every order one move away competes for the pointer
  drag_a: { kind: closest, over: pa, grab: a, action: move, stickiness: 6, floating: true }
  drag_b: { kind: closest, over: pb, grab: b, action: move, stickiness: 6, floating: true }
  drag_c: { kind: closest, over: pc, grab: c, action: move, stickiness: 6, floating: true }
  drag_d: { kind: closest, over: pd, grab: d, action: move, stickiness: 6, floating: true }
  drag_e: { kind: closest, over: pe, grab: e, action: move, stickiness: 6, floating: true }
initial: {pa: 0, pb: 1, pc: 2, pd: 3, pe: 4}
