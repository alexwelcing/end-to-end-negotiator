# Dragology's `rush-hour` (src/demos/rush-hour.tsx): a car slides along its row or column, any number
# of cells, until the next is off the board or taken; the red car alone may drive two cells past the
# right edge, which is how it gets out. Scaled down from 6 x 6 with eight cars to 5 x 5 with six: each
# car is one int, its position along its line, so there are 4,608 tuples, 360 of them boards.
# From the start the red car is out in 4 drags. Dragology slides a car smoothly between its
# stops (`between`); here the drop snaps to the closest one.
# Generated by scripts/gen_rush_hour_spec.py; edit the script, not this file.
nerve: 1
name: rush_hour
state:
  red: {type: int, range: [0, 5]}   # horizontal, length 2: row 2, left end; past 3 it drives off the board, and at 5 it is out
  a: {type: int, range: [0, 2]}   # horizontal, length 3: row 0, left end
  b: {type: int, range: [0, 3]}   # vertical, length 2: column 2, top end
  c: {type: int, range: [0, 3]}   # vertical, length 2: column 4, top end
  d: {type: int, range: [0, 3]}   # horizontal, length 2: row 4, left end
  e: {type: int, range: [0, 3]}   # horizontal, length 2: row 4, left end
actions:
  slide_red: {params: {to: {type: int, range: [0, 5]}}}
  slide_a: {params: {to: {type: int, range: [0, 2]}}}
  slide_b: {params: {to: {type: int, range: [0, 3]}}}
  slide_c: {params: {to: {type: int, range: [0, 3]}}}
  slide_d: {params: {to: {type: int, range: [0, 3]}}}
  slide_e: {params: {to: {type: int, range: [0, 3]}}}
transitions:
  # a car goes to `to` when no other car touches a cell it would sweep through on the way
  slide_red:
    when: "not (min(red, to) <= 2 <= max(red, to) + 1 and 1 <= b <= 2) and not (min(red, to) <= 4 <= max(red, to) + 1 and 1 <= c <= 2)"
    red: "to"
  slide_a:
    when: "not (min(a, to) <= 2 <= max(a, to) + 2 and b == 0) and not (min(a, to) <= 4 <= max(a, to) + 2 and c == 0)"
    a: "to"
  slide_b:
    when: "not (min(b, to) <= 2 <= max(b, to) + 1 and 1 <= red <= 2) and not (min(b, to) <= 0 <= max(b, to) + 1) and not (min(b, to) <= 4 <= max(b, to) + 1 and 1 <= d <= 2) and not (min(b, to) <= 4 <= max(b, to) + 1 and 1 <= e <= 2)"
    b: "to"
  slide_c:
    when: "not (min(c, to) <= 2 <= max(c, to) + 1 and 3 <= red <= 4) and not (min(c, to) <= 0 <= max(c, to) + 1 and a == 2) and not (min(c, to) <= 4 <= max(c, to) + 1 and d == 3) and not (min(c, to) <= 4 <= max(c, to) + 1 and e == 3)"
    c: "to"
  slide_d:
    when: "not (min(d, to) <= 2 <= max(d, to) + 1 and b == 3) and not (min(d, to) <= 4 <= max(d, to) + 1 and c == 3) and not (e <= max(d, to) + 1 and min(d, to) <= e + 1)"
    d: "to"
  slide_e:
    when: "not (min(e, to) <= 2 <= max(e, to) + 1 and b == 3) and not (min(e, to) <= 4 <= max(e, to) + 1 and c == 3) and not (d <= max(e, to) + 1 and min(e, to) <= d + 1)"
    e: "to"
invariants:
  - "not (1 <= red <= 2 and 1 <= b <= 2)"   # red and b never share a cell
  - "not (3 <= red <= 4 and 1 <= c <= 2)"   # red and c never share a cell
  - "not (b == 0)"   # a and b never share a cell
  - "not (a == 2 and c == 0)"   # a and c never share a cell
  - "not (b == 3 and 1 <= d <= 2)"   # b and d never share a cell
  - "not (b == 3 and 1 <= e <= 2)"   # b and e never share a cell
  - "not (c == 3 and d == 3)"   # c and d never share a cell
  - "not (c == 3 and e == 3)"   # c and e never share a cell
  - "not (d < e + 2 and e < d + 2)"   # d and e never share a cell
ensures:
  - { holds: "int(red != old.red) + int(a != old.a) + int(b != old.b) + int(c != old.c) + int(d != old.d) + int(e != old.e) <= 1" }   # one car moves at a time
  - { holds: "not (min(old.red, red) <= 2 <= max(old.red, red) + 1 and 1 <= old.b <= 2) and not (min(old.red, red) <= 4 <= max(old.red, red) + 1 and 1 <= old.c <= 2)" }   # red never passes through another car
  - { holds: "not (min(old.a, a) <= 2 <= max(old.a, a) + 2 and old.b == 0) and not (min(old.a, a) <= 4 <= max(old.a, a) + 2 and old.c == 0)" }   # a never passes through another car
  - { holds: "not (min(old.b, b) <= 2 <= max(old.b, b) + 1 and 1 <= old.red <= 2) and not (min(old.b, b) <= 0 <= max(old.b, b) + 1) and not (min(old.b, b) <= 4 <= max(old.b, b) + 1 and 1 <= old.d <= 2) and not (min(old.b, b) <= 4 <= max(old.b, b) + 1 and 1 <= old.e <= 2)" }   # b never passes through another car
  - { holds: "not (min(old.c, c) <= 2 <= max(old.c, c) + 1 and 3 <= old.red <= 4) and not (min(old.c, c) <= 0 <= max(old.c, c) + 1 and old.a == 2) and not (min(old.c, c) <= 4 <= max(old.c, c) + 1 and old.d == 3) and not (min(old.c, c) <= 4 <= max(old.c, c) + 1 and old.e == 3)" }   # c never passes through another car
  - { holds: "not (min(old.d, d) <= 2 <= max(old.d, d) + 1 and old.b == 3) and not (min(old.d, d) <= 4 <= max(old.d, d) + 1 and old.c == 3) and not (old.e <= max(old.d, d) + 1 and min(old.d, d) <= old.e + 1)" }   # d never passes through another car
  - { holds: "not (min(old.e, e) <= 2 <= max(old.e, e) + 1 and old.b == 3) and not (min(old.e, e) <= 4 <= max(old.e, e) + 1 and old.c == 3) and not (old.d <= max(old.e, e) + 1 and min(old.e, e) <= old.d + 1)" }   # e never passes through another car
  - { after: slide_red, holds: "red == to or red == old.red" }   # it stops where it was dropped, or stays
  - { after: slide_a, holds: "a == to or a == old.a" }   # it stops where it was dropped, or stays
  - { after: slide_b, holds: "b == to or b == old.b" }   # it stops where it was dropped, or stays
  - { after: slide_c, holds: "c == to or c == old.c" }   # it stops where it was dropped, or stays
  - { after: slide_d, holds: "d == to or d == old.d" }   # it stops where it was dropped, or stays
  - { after: slide_e, holds: "e == to or e == old.e" }   # it stops where it was dropped, or stays
render:
  red: { x: "80 + 50 * red", y: "155" }
  a: { x: "105 + 50 * a", y: "55" }
  b: { x: "155", y: "80 + 50 * b" }
  c: { x: "255", y: "80 + 50 * c" }
  d: { x: "80 + 50 * d", y: "255" }
  e: { x: "80 + 50 * e", y: "255" }
futures:
  # one gesture per car: every stop it can slide to along its line, in either direction
  drag_red: { kind: closest, over: red, grab: red, action: slide_red, stickiness: 6, floating: true }
  drag_a: { kind: closest, over: a, grab: a, action: slide_a, stickiness: 6, floating: true }
  drag_b: { kind: closest, over: b, grab: b, action: slide_b, stickiness: 6, floating: true }
  drag_c: { kind: closest, over: c, grab: c, action: slide_c, stickiness: 6, floating: true }
  drag_d: { kind: closest, over: d, grab: d, action: slide_d, stickiness: 6, floating: true }
  drag_e: { kind: closest, over: e, grab: e, action: slide_e, stickiness: 6, floating: true }
initial: {red: 0, a: 1, b: 1, c: 2, d: 1, e: 3}
